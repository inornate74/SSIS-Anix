                                  errorRowDisposition="FailComponent"
                                  externalMetadataColumnId="Package\КПТ online\ОТБРС\Загрузка матрицы\Загрузка матрицы  Признак 5 (отбор по дате) 1\DWH.Outputs[ADO NET Source Output].ExternalColumns[КодМагазина]"
