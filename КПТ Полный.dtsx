            <DTS:Executable
              DTS:refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 1 Потери"
              DTS:CreationName="Microsoft.Pipeline"
              DTS:Description="Data Flow Task"
              DTS:DTSID="{69315E1B-CCDC-4E02-A7EE-5ED8E3A81AC1}"
              DTS:ExecutableType="Microsoft.Pipeline"
              DTS:LocaleID="-1"
              DTS:ObjectName="Определение причин Этап 2 1 Потери"
              DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server v10; (C) 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
              <DTS:Variables />
              <DTS:LoggingOptions
                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <pipeline
                  BLOBTempStoragePath=""
                  bufferTempStoragePath=""
                  version="1">
                  <components>
                    <component
                      refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 1 Потери\_Свод временный1"
                      componentClassID="Microsoft.ManagedComponentHost"
                      contactInfo="Extracts data from a relational database by using a .NET provider.;Microsoft Corporation; Microsoft SqlServer v10; © 2007 Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                      description="Extracts data from a relational database by using a .NET provider."
                      name="_Свод временный1"
                      usesDispositions="true"
                      version="4">
                      <properties>
                        <property
                          dataType="System.String"
                          description="Specifies the SQL statement used by the component to extract data."
                          expressionType="Notify"
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">select
		 Свод_временный1.Дата Дата
		,Свод_временный1.КодТовара КодТовара
		,Свод_временный1.КодПоставщика КодПоставщика
		,Свод_временный1.[КодМагазина] [КодМагазина]
		,cast(Потери.КПТост as numeric(6,3)) КПТаутстоков
		,Потери.Причина КодПричиныПаденияКПТ
		,left(LTRIM(RTRIM( convert(varchar, Свод_временный1.Дата, 112)))+'_'+
				RTRIM(LTRIM(CAST(Свод_временный1.КодТовара as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(Свод_временный1.КодМагазина as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(Свод_временный1.КодПоставщика as CHAR)))
		,41) ДатаТоварМагазинПоставщик
	from Свод_временный1 with (nolock)
	left join 
	(select
		C2.Дата Дата,
		C2.КодТовара КодТовара,
		C2.КодМагазина КодМагазина,
		C2.КолВоДней КолВоДней,
		C2.ДнейНаСкладеПоОстаткам ДнейНаСкладеПоОстаткам,
		C2.КодПоставщика,
		case when C2.КолВоДней = null then 0 else Round(C2.ДнейНаСкладеПоОстаткам/C2.КолВоДней,3) end КПТост,
		0 Причина
		from Свод_временный1 C2 with (nolock)
	 Union all
	 -- ПОТЕРИ - ВОЗВРАТЫ
	 --  WHEN ДокПотери.sp1832 IN ('36','37','38') THEN 'Возвраты'
	 --  WHEN ДокПотери.sp1832 IN ('42','19','17') THEN 'Инвентаризации'
	 --    WHEN ДокПотери.sp1832 IN ('25') THEN 'НепродаваемыйТовар'
	 select
		C3.Дата Дата,
		C3.КодТовара КодТовара,
		C3.КодМагазина КодМагазина,
		C3.КолВоДней КолВоДней,
		C3.ДнейНаСкладеПоОстаткам ДнейНаСкладеПоОстаткам,
		C3.КодПоставщика,
		0 КПТост,
		6 Причина
	 from Свод_временный1 C3 with (nolock)
	 where (case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100 
		and C3.КодТовара IN (select TOP 1 ОТБРС_Потери.КодТовара from ОТБРС_Потери with (nolock)
								where  ОТБРС_Потери.КодТовара = C3.КодТовара
								AND ОТБРС_Потери.Дата &lt;= C3.Дата and (ОТБРС_Потери.Дата &gt;= (select top 1 Дата_заявки_СТ from dwh.td.t_fact_Заявка_СТ_шапки h
																join dwh.td.t_fact_Заявка_СТ_строки s on s.Составной_код_заявки_СТ=h.Составной_код_заявки_СТ
																where h.Дата_заявки_СТ&gt;=dateadd(d,-14,c3.дата) and
																Дата_заявки_СТ&lt;=C3.Дата and c3.КодТовара=s.Код_товара and c3.КодМагазина=h.Код_магазина
															order by Дата_заявки_СТ desc) or 
                                                                ОТБРС_Потери.Дата &gt;=(select top 1 [Дата_заявки_РЦ] from dwh.td.t_fact_Заявка_РЦ_шапки h
																join dwh.td.t_fact_Заявка_РЦ_строки s on s.Составной_код_заявки_РЦ=h.Составной_код_заявки_РЦ
																where Дата_заявки_РЦ&gt;= dateadd(d,-14,c3.дата) and
																Дата_заявки_РЦ&lt;=C3.Дата and c3.КодТовара=s.Код_товара and c3.КодМагазина=h.Код_магазина
															order by Дата_заявки_РЦ desc) )
								AND ОТБРС_Потери.КодМагазина = C3.КодМагазина
								AND  ОТБРС_Потери.КодПричины IN ('36','37','38')) 
	 Union all
	 -- ПОТЕРИ - Инвентаризации
	 select
		C3.Дата Дата,
		C3.КодТовара КодТовара,
		C3.КодМагазина КодМагазина,
		C3.КолВоДней КолВоДней,
		C3.ДнейНаСкладеПоОстаткам ДнейНаСкладеПоОстаткам,
		C3.КодПоставщика,
		0 КПТост,
		7 Причина
	 from Свод_временный1 C3 with (nolock)
	 where (case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100 
		  and  C3.КодТовара IN (select TOP 1 ОТБРС_Потери.КодТовара from ОТБРС_Потери with (nolock)
								where  ОТБРС_Потери.КодТовара = C3.КодТовара
								AND ОТБРС_Потери.Дата &lt;= C3.Дата and (ОТБРС_Потери.Дата &gt;= (select top 1 Дата_заявки_СТ from dwh.td.t_fact_Заявка_СТ_шапки h
																join dwh.td.t_fact_Заявка_СТ_строки s on s.Составной_код_заявки_СТ=h.Составной_код_заявки_СТ
																where h.Дата_заявки_СТ&gt;=dateadd(d,-14,c3.дата) and
																Дата_заявки_СТ&lt;=C3.Дата and c3.КодТовара=s.Код_товара and c3.КодМагазина=h.Код_магазина
															order by Дата_заявки_СТ desc) or 
                                                                ОТБРС_Потери.Дата &gt;=(select top 1 [Дата_заявки_РЦ] from dwh.td.t_fact_Заявка_РЦ_шапки h
																join dwh.td.t_fact_Заявка_РЦ_строки s on s.Составной_код_заявки_РЦ=h.Составной_код_заявки_РЦ
																where Дата_заявки_РЦ&gt;= dateadd(d,-14,c3.дата) and
																Дата_заявки_РЦ&lt;=C3.Дата and c3.КодТовара=s.Код_товара and c3.КодМагазина=h.Код_магазина
															order by Дата_заявки_РЦ desc) )
								AND ОТБРС_Потери.КодМагазина = C3.КодМагазина
								AND  ОТБРС_Потери.КодПричины IN ('76','54','43','70','88','175','56','18','66','42','19','17')
								and ОТБРС_Потери.Количество &lt; 0
								order by ОТБРС_Потери.Дата desc)	 
		--проверяем приходы после инвентаризации для следующих дней
		and (case when (select TOP 1 ОТБРС_Потери.Дата
						from ОТБРС_Потери with (nolock)
						 where ОТБРС_Потери.КодТовара = C3.КодТовара
						 AND ОТБРС_Потери.Дата &lt;= C3.Дата and (ОТБРС_Потери.Дата &gt;= (select top 1 Дата_заявки_СТ from dwh.td.t_fact_Заявка_СТ_шапки h
																join dwh.td.t_fact_Заявка_СТ_строки s on s.Составной_код_заявки_СТ=h.Составной_код_заявки_СТ
																where h.Дата_заявки_СТ&gt;=dateadd(d,-14,c3.дата) and
																Дата_заявки_СТ&lt;=C3.Дата and c3.КодТовара=s.Код_товара and c3.КодМагазина=h.Код_магазина
															order by Дата_заявки_СТ desc) or 
                                                                ОТБРС_Потери.Дата &gt;=(select top 1 [Дата_заявки_РЦ] from dwh.td.t_fact_Заявка_РЦ_шапки h
																join dwh.td.t_fact_Заявка_РЦ_строки s on s.Составной_код_заявки_РЦ=h.Составной_код_заявки_РЦ
																where Дата_заявки_РЦ&gt;= dateadd(d,-14,c3.дата) and
																Дата_заявки_РЦ&lt;=C3.Дата and c3.КодТовара=s.Код_товара and c3.КодМагазина=h.Код_магазина
															order by Дата_заявки_РЦ desc) )
						 AND ОТБРС_Потери.КодМагазина = C3.КодМагазина
						 AND  ОТБРС_Потери.КодПричины IN ('42','19','17')
						 and ОТБРС_Потери.Количество &lt; 0
						 order by ОТБРС_Потери.Дата desc
						 ) is not null 
				then
				isnull((select SUM(RSC_Приход.Количество)
						from RSC_Приход with (nolock)
						 where RSC_Приход.КодТовара = C3.КодТовара
						AND RSC_Приход.КодМагазина = C3.КодМагазина
						AND RSC_Приход.Дата &lt; C3.Дата--без равенства, т.к. в этот день поставка не должна учитываться
						AND RSC_Приход.Дата &gt;= (select TOP 1 ОТБРС_Потери.Дата
												from ОТБРС_Потери with (nolock)
												 where ОТБРС_Потери.КодТовара = C3.КодТовара
												 AND ОТБРС_Потери.Дата &lt;= C3.Дата
												 AND ОТБРС_Потери.КодМагазина = C3.КодМагазина
												 AND  ОТБРС_Потери.КодПричины IN ('76','54','43','70','88','175','56','18','66','42','19','17')
												 and ОТБРС_Потери.Количество &lt; 0
												 order by ОТБРС_Потери.Дата desc
														 )),0)
				else 0
				end) = 0
		
	Union all
	 -- ПОТЕРИ - НепродаваемыйТовар
	 select
		C3.Дата Дата,
		C3.КодТовара КодТовара,
		C3.КодМагазина КодМагазина,
		C3.КолВоДней КолВоДней,
		C3.ДнейНаСкладеПоОстаткам ДнейНаСкладеПоОстаткам,
		C3.КодПоставщика,
		0 КПТост,
		8 Причина
	 from Свод_временный1 C3 with (nolock)
	 where (case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100 	 
				and C3.КодТовара IN (select TOP 1 ОТБРС_Потери.КодТовара from ОТБРС_Потери with (nolock)
								where  ОТБРС_Потери.КодТовара = C3.КодТовара
								AND ОТБРС_Потери.Дата = C3.Дата and (ОТБРС_Потери.Дата &gt;= (select top 1 Дата_заявки_СТ from dwh.td.t_fact_Заявка_СТ_шапки h
																join dwh.td.t_fact_Заявка_СТ_строки s on s.Составной_код_заявки_СТ=h.Составной_код_заявки_СТ
																where h.Дата_заявки_СТ&gt;=dateadd(d,-14,c3.дата) and
																Дата_заявки_СТ&lt;=C3.Дата and c3.КодТовара=s.Код_товара and c3.КодМагазина=h.Код_магазина
															order by Дата_заявки_СТ desc) or 
                                                                ОТБРС_Потери.Дата &gt;=(select top 1 [Дата_заявки_РЦ] from dwh.td.t_fact_Заявка_РЦ_шапки h
																join dwh.td.t_fact_Заявка_РЦ_строки s on s.Составной_код_заявки_РЦ=h.Составной_код_заявки_РЦ
																where Дата_заявки_РЦ&gt;= dateadd(d,-14,c3.дата) and
																Дата_заявки_РЦ&lt;=C3.Дата and c3.КодТовара=s.Код_товара and c3.КодМагазина=h.Код_магазина
															order by Дата_заявки_РЦ desc) )
								AND ОТБРС_Потери.КодМагазина = C3.КодМагазина
								AND ОТБРС_Потери.КодПричины IN ('25'))
	 ) Потери
																			ON Потери.Дата = Свод_временный1.Дата 
																			AND Потери.КодТовара =Свод_временный1.КодТовара 
																			AND Потери.КодМагазина = Свод_временный1.КодМагазина 
																			AND Потери.КодПоставщика = Свод_временный1.КодПоставщика</property>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.Boolean"
                          description="Indicates whether to allow non-string external columns to be implicitly converted to strings at the output columns."
                          name="AllowImplicitStringConversion">true</property>
                        <property
                          dataType="System.String"
                          description="The Destination database table name."
                          expressionType="Notify"
                          name="TableOrViewName"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor"></property>
                        <property
                          dataType="System.Int32"
                          description="Specify the mode to retrieve external column information"
                          name="AccessMode"
                          typeConverter="Microsoft.SqlServer.Dts.Pipeline.DataReaderSourceAdapter+EnumToStringConverter">2</property>
                        <property
                          dataType="System.String"
                          name="UserComponentTypeName">Microsoft.DataReaderSourceAdapter</property>
                      </properties>
                      <connections>
                        <connection
                          refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 1 Потери\_Свод временный1.Connections[IDbConnection]"
                          connectionManagerID="Package.ConnectionManagers[s19-olap.KPT.reader ADO .net]"
                          connectionManagerRefId="Package.ConnectionManagers[s19-olap.KPT.reader ADO .net]"
                          description="Managed connection manager"
                          name="IDbConnection" />
                      </connections>
                      <outputs>
                        <output
                          refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 1 Потери\_Свод временный1.Outputs[ADO NET Source Output]"
                          name="ADO NET Source Output">
                          <outputColumns>
                            <outputColumn
                              refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 1 Потери\_Свод временный1.Outputs[ADO NET Source Output].Columns[Дата]"
                              dataType="dbDate"
