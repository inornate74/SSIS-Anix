                    <component
                      refId="Package\КПТ по причинам (сбор данных)\ОТБРС\Загрузка Графика заказа из ОТБРС\ОТБРС"
                      componentClassID="Microsoft.ManagedComponentHost"
                      contactInfo="Extracts data from a relational database by using a .NET provider.;Microsoft Corporation; Microsoft SqlServer v10; © 2007 Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                      description="Extracts data from a relational database by using a .NET provider."
                      name="ОТБРС"
                      usesDispositions="true"
                      version="4">
                      <properties>
                        <property
                          dataType="System.String"
                          description="Specifies the SQL statement used by the component to extract data."
                          expressionType="Notify"
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
	спрМагазины.Code КодМагазина,
	спрГруппы.Code КодГруппыТовара,
	спрПоставщики.Code КодПоставщика,
	спрГрафики.sp1860 Режим,
	спрГрафики.sp3784 ДатаИзмРежима,
	спрГрафики.sp2140 ДатаЗаписи,
	спрГрафики.sp4621 ДатаСменыПоставщика,
	спрГруппЗаказа.sp2180 ЗапретЗаказаРЦ
FROM 
	sc1866 спрГрафики (NoLock) 
	LEFT JOIN sc36 спрМагазины (NoLock) On спрМагазины.ID = спрГрафики.sp1857 
	LEFT JOIN sc36 спрПоставщики (NoLock) On спрПоставщики.ID = спрГрафики.sp1859
	LEFT JOIN sc1866 спрГруппЗаказа (NoLock) ON спрГрафики.ParentID = спрГруппЗаказа.ID
	LEFT JOIN sc11 спрГруппы (NoLock) On спрГруппы.ID = спрГруппЗаказа.sp1858
WHERE 
	спрГруппы.ID Is Not NULL</property>
