                <component
                  refId="Package\КПТ по причинам (определение причин)\Определение причин Этап 4 Распределение КПТ\_Свод временный приоритеты"
                  componentClassID="Microsoft.ManagedComponentHost"
                  contactInfo="Extracts data from a relational database by using a .NET provider.;Microsoft Corporation; Microsoft SqlServer v10; © 2007 Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                  description="Extracts data from a relational database by using a .NET provider."
                  name="_Свод временный приоритеты"
                  usesDispositions="true"
                  version="4">
                  <properties>
                    <property
                      dataType="System.String"
                      description="Specifies the SQL statement used by the component to extract data."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT
	Т1.[Дата]
      ,Т1.[КодТовара]
      ,Т1.[КодПоставщика]
      ,Т1.[КодМагазина]
      ,Т1.[КодПричиныПаденияКПТ]
     , case  when  Т1.[КПТаутстоков] &gt; 0 then Т1.[КПТаутстоков] 
                 when  (Т1.[КПТаутстоков] = 0 and Т1.[КодПричиныПаденияКПТ]=0) then Т1.[КПТаутстоков]
                else
	 (case when (select count(Т2.КодТовара) from [KPT].[dbo].Свод_временный_приоритеты  Т2 (nolock) where Т2.Дата = Т1.Дата and Т2.КодТовара = Т1.КодТовара 
						and Т2.[КодПричиныПаденияКПТ] &lt;&gt; 0 and Т2.КодМагазина = Т1.КодМагазина) = 0  then 0 
			else (
				(case when (select TOP 1 Т2.[КПТаутстоков] from [KPT].[dbo].Свод_временный_приоритеты (nolock) Т2 where Т2.Дата = Т1.Дата and Т2.КодТовара = Т1.КодТовара 
					and Т2.[КодПричиныПаденияКПТ] = 0 and Т2.КодМагазина = Т1.КодМагазина) = 0 then 1
				else (1 -(select TOP 1 Т2.[КПТаутстоков] from [KPT].[dbo].Свод_временный_приоритеты Т2 (nolock) where Т2.Дата = Т1.Дата and Т2.КодТовара = Т1.КодТовара 
					and Т2.[КодПричиныПаденияКПТ] = 0 and Т2.КодМагазина = Т1.КодМагазина))
				end)
					/(select count(Т2.КодТовара) from [KPT].[dbo].Свод_временный_приоритеты Т2 (nolock) where Т2.Дата = Т1.Дата and Т2.КодТовара = Т1.КодТовара 
						and Т2.[КодПричиныПаденияКПТ] &lt;&gt; 0 and Т2.КодМагазина = Т1.КодМагазина) 
				)
			end)
      end [КПТаутстоков] 
  FROM [KPT].[dbo].Свод_временный_приоритеты Т1</property>
                    <property
