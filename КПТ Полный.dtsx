            <DTS:Executable
              DTS:refId="Package\КПТ\Формирование итоговой таблицы\Удалить из свода первый заказ"
              DTS:CreationName="Microsoft.ExecuteSQLTask"
              DTS:Description="Execute SQL Task"
              DTS:DTSID="{2079385A-1ECE-42FC-8C2D-CFDDAB917C9F}"
              DTS:ExecutableType="Microsoft.ExecuteSQLTask"
              DTS:LocaleID="-1"
              DTS:ObjectName="Удалить из свода первый заказ"
              DTS:TaskContact="Execute SQL Task; Microsoft Corporation; Microsoft SQL Server 2008 R2; © 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
              DTS:ThreadHint="0">
              <DTS:Variables />
              <DTS:LoggingOptions
                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <SQLTask:SqlTaskData
                  SQLTask:Connection="{ACF2DB4A-C351-4E89-845A-CFB8050E8574}"
                  SQLTask:SqlStatementSource="set datefirst 7&#xA;&#xA;declare @date as datetime&#xA;declare @dateN as datetime&#xA;declare @curdate as datetime&#xA;&#xA;set @curdate=convert(varchar(16), dateadd(day, -7, getdate()), 112)&#xA;&#xA;set @date =CASE &#xA;WHEN DATEPART(weekday, @curdate) = 1 THEN @curdate &#xA;WHEN DATEPART(weekday, @curdate) = 2 THEN dateadd(day, + 6, @curdate) &#xA;WHEN DATEPART(weekday, @curdate) = 3 THEN dateadd(day, + 5, @curdate) &#xA;WHEN DATEPART(weekday, @curdate) = 4 THEN dateadd(day, + 4, @curdate) &#xA;WHEN DATEPART(weekday, @curdate) = 5 THEN dateadd(day, + 3, @curdate) &#xA;WHEN DATEPART(weekday, @curdate) = 6 THEN dateadd(day, + 2, @curdate) &#xA;WHEN DATEPART(weekday, @curdate) = 7 THEN dateadd(day, + 1, @curdate)&#xA;END&#xA;set @dateN = dateadd(dd, -6, @date)&#xA;&#xA;&#xA;delete свод &#xA;from свод s &#xA;where ВидАсс14днейНазад is null &#xA;and  Дата between @dateN and @date&#xA;and  not exists (select *  from dwh.td.v_fact_ПД tbl &#xA;where tbl.Дата_ПД&gt;=dateadd(d,-7,@date) and tbl.Дата_ПД&lt;=s.Дата and tbl.Код_магазина=s.КодМагазина and s.КодТовара=tbl.Код_Товара &#xA;);&#xA;&#xA;delete свод &#xA;from свод s &#xA;where ВидАсс14днейНазад in (1,4,5,7,8,9,10,0) -- выполняется&#xA;and  Дата between @dateN and @date -- выполняется&#xA;and  not exists (select *  from dwh.td.v_fact_ПД tbl &#xA;where tbl.Дата_ПД&gt;=(Select top (1) tm.Дата from   dwh.td.t_fact_Товарная_матрица as tm where tm.Код_товара=tbl.Код_товара and tm.Код_магазина=tbl.Код_магазина and tm.Дата&lt;=s.Дата&#xA;order by tm.Дата desc ) &#xA;&#xA;and tbl.Дата_ПД&lt;=s.Дата and tbl.Код_магазина=s.КодМагазина and s.КодТовара=tbl.Код_Товара &#xA;) ;&#xA;&#xA;delete Свод &#xA;from Свод as s&#xA;where  Дата between @dateN and @date&#xA; and &#xA; exists (select * from &#xA;(select tm.код_магазина,Код_товара, дата &#xA; from dwh.td.t_fact_Товарная_матрица tm&#xA;&#xA; where  Дата between @dateN and @date&#xA; and &#xA;  (&#xA;select  top 1 tm1.Признак &#xA;   from dwh.td.t_fact_Товарная_матрица tm1 &#xA;  where Признак!=0&#xA;&#xA;  and tm.Код_товара=tm1.Код_товара &#xA;  and tm.Код_магазина=tm1.Код_магазина&#xA;&#xA;  and tm1.Дата&lt;=@dateN&#xA;  &#xA;order by Дата desc) in (1,5,7,8,10,0)) as tm&#xA; &#xA;where tm.Дата&gt;s.дата and tm.Код_магазина=s.КодМагазина and s.КодТовара=tm.Код_товара );&#xA;&#xA;&#xA;delete Свод &#xA;from Свод as s&#xA;&#xA;where Дата between @dateN and @date&#xA;and &#xA;exists&#xA;(select * from &#xA; &#xA;(select tm.код_магазина,Код_товара, дата &#xA; from dwh.td.t_fact_Товарная_матрица tm&#xA; &#xA;where  Дата between @dateN and @date&#xA; and exists(&#xA;select   Код_магазина,Код_товара,count(*)  &#xA;  from dwh.td.t_fact_Товарная_матрица tm1 &#xA;  where Признак!=0&#xA;&#xA;  and tm.Код_товара=tm1.Код_товара &#xA;  and tm.Код_магазина=tm1.Код_магазина&#xA;&#xA;  group by Код_магазина,Код_товара&#xA;&#xA;  having count(*)=1)) as tm&#xA; &#xA;where tm.Дата&gt;s.дата and tm.Код_магазина=s.КодМагазина and s.КодТовара=tm.Код_товара );" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
              </DTS:ObjectData>
            </DTS:Executable>
