                          description="Specifies the SQL statement used by the component to extract data."
                          expressionType="Notify"
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">--_InfoRg2949 РегистрСведений.ДопустимаяПогрешностьКоличестваТовара
/*_Period	Период
_Fld2958RRef	ГруппаТовара
_Fld2959	ПогрешностьКоличество
_Fld2960	ПогрешностьПроцент
_Fld3469	ПогрешностьКоличествоСП
_Fld3470	ПогрешностьПроцентСП*/
--_Reference2948 Справочник.ГруппыОТБРС

Select 
 Case  РегПогрешность._Period
          When '01.01.2001 00:00:00.000' Then Null
          Else convert(datetime, convert(varchar, dateadd(yyyy,-2000, РегПогрешность._Period), 112))  END Дата
 ,спрГруппыОТБРС._Code КодГруппыТовара
 ,РегПогрешность._Fld2959 ПогрешностьКоличество
 ,РегПогрешность._Fld2960 ПогрешностьПроцент
 ,РегПогрешность._Fld3469 ПогрешностьКоличествоСП
 ,РегПогрешность._Fld3470 ПогрешностьПроцентСП
from  _InfoRg2949  РегПогрешность (nolock)
inner join  _Reference2948 спрГруппыОТБРС (nolock) ON спрГруппыОТБРС._IDRRef = РегПогрешность._Fld2958RRef</property>
