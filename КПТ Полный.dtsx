                          name="Вывод источника ADO NET">
                          <outputColumns>
                            <outputColumn
                              refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Первый заказ\Источник - ADO NET.Outputs[Вывод источника ADO NET].Columns[Дата]"
