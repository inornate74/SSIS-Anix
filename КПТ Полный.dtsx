            <DTS:Executable
              DTS:refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 3 График заказа"
              DTS:CreationName="Microsoft.Pipeline"
              DTS:Description="Data Flow Task"
              DTS:DTSID="{6261C0C3-2CCB-43B4-A018-ACE5E3F0B80E}"
              DTS:ExecutableType="Microsoft.Pipeline"
              DTS:LocaleID="-1"
              DTS:ObjectName="Определение причин Этап 2 3 График заказа"
              DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server v10; (C) 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
              <DTS:Variables />
              <DTS:LoggingOptions
                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <pipeline
                  BLOBTempStoragePath=""
                  bufferTempStoragePath=""
                  version="1">
                  <components>
                    <component
                      refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 3 График заказа\_Свод_временный1"
                      componentClassID="Microsoft.ManagedComponentHost"
                      contactInfo="Extracts data from a relational database by using a .NET provider.;Microsoft Corporation; Microsoft SqlServer v10; © 2007 Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                      description="Extracts data from a relational database by using a .NET provider."
                      name="_Свод_временный1"
                      usesDispositions="true"
                      version="4">
                      <properties>
                        <property
                          dataType="System.String"
                          description="Specifies the SQL statement used by the component to extract data."
                          expressionType="Notify"
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">-- Графики заказа - НАЛИЧИЕ ГРАФИКА ЗАКАЗА
	select
		 C3.Дата Дата
		,C3.КодТовара КодТовара
		,C3.КодПоставщика КодПоставщика
		,C3.[КодМагазина] [КодМагазина]
		,0 КПТаутстоков
		,cast(2 as tinyint) КодПричиныПаденияКПТ
		,left(LTRIM(RTRIM( convert(varchar, C3.Дата, 112)))+'_'+
				RTRIM(LTRIM(CAST(C3.КодТовара as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодМагазина as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодПоставщика as CHAR)))
		,41) ДатаТоварМагазинПоставщик
	from Свод_временный1 C3 with (nolock)
	where (case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100
 			and C3.КодТовара IN (select ПричиныПаденияКПТ.КодТовара from ПричиныПаденияКПТ with (nolock)
								where  ПричиныПаденияКПТ.КодТовара = C3.КодТовара
								AND ПричиныПаденияКПТ.Дата = C3.Дата
								AND ПричиныПаденияКПТ.КодМагазина = C3.КодМагазина
								AND ПричиныПаденияКПТ.НаличиеГрафика = 0)
	 	
	Union all
	 -- Графики заказа - ЗАПРЕТ ГРАФИКА РЦ
	select
		 C3.Дата Дата
		,C3.КодТовара КодТовара
		,C3.КодПоставщика КодПоставщика
		,C3.[КодМагазина] [КодМагазина]
		,0 КПТаутстоков
		,cast(4 as tinyint) КодПричиныПаденияКПТ
		,left(LTRIM(RTRIM( convert(varchar, C3.Дата, 112)))+'_'+
				RTRIM(LTRIM(CAST(C3.КодТовара as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодМагазина as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодПоставщика as CHAR)))
		,41) ДатаТоварМагазинПоставщик
	 from Свод_временный1 C3 with (nolock)
	 where C3.КодПоставщика = 1682 
		and (case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100
		and C3.КодТовара IN (select ПричиныПаденияКПТ.КодТовара from ПричиныПаденияКПТ with (nolock)
								where  ПричиныПаденияКПТ.КодТовара = C3.КодТовара
								AND ПричиныПаденияКПТ.Дата = C3.Дата
								AND ПричиныПаденияКПТ.КодМагазина = C3.КодМагазина
								AND ПричиныПаденияКПТ.ЗапретЗаказаРЦ = 1)

	Union all
	 -- Графики заказа - СМЕНА ПОСТАВЩИКА
	select
		 C3.Дата Дата
		,C3.КодТовара КодТовара
		,C3.КодПоставщика КодПоставщика
		,C3.[КодМагазина] [КодМагазина]
		,0 КПТаутстоков
		,cast(3 as tinyint) КодПричиныПаденияКПТ
		,left(LTRIM(RTRIM( convert(varchar, C3.Дата, 112)))+'_'+
				RTRIM(LTRIM(CAST(C3.КодТовара as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодМагазина as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодПоставщика as CHAR)))
		,41) ДатаТоварМагазинПоставщик
	 from Свод_временный1 C3 with (nolock)
	 where (case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100
		and C3.КодТовара IN (select ПричиныПаденияКПТ.КодТовара from ПричиныПаденияКПТ with (nolock)
								where  ПричиныПаденияКПТ.КодТовара = C3.КодТовара
								AND ПричиныПаденияКПТ.Дата = C3.Дата
								AND ПричиныПаденияКПТ.КодМагазина = C3.КодМагазина
								AND ПричиныПаденияКПТ.СменаПоставщика = 1)</property>
