                    <component
                      refId="Package\КПТ\Формирование итоговой таблицы\Перенос в свод\Свод_ступень_обработки_1"
                      componentClassID="Microsoft.ManagedComponentHost"
                      contactInfo="Extracts data from a relational database by using a .NET provider.;Microsoft Corporation; Microsoft SqlServer v10; © 2007 Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                      description="Extracts data from a relational database by using a .NET provider."
                      name="Свод_ступень_обработки_1"
                      usesDispositions="true"
                      version="4">
                      <properties>
                        <property
                          dataType="System.String"
                          description="Specifies the SQL statement used by the component to extract data."
                          expressionType="Notify"
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT dbo.Свод_ступень_обработки_1.[Дата]
      ,dbo.Свод_ступень_обработки_1.[КодТовара]
      ,dbo.Свод_ступень_обработки_1.[КодПоставщика]
      ,dbo.Свод_ступень_обработки_1.[КодМагазина]
      ,dbo.Свод_ступень_обработки_1.[ТОП]
      ,dbo.Свод_ступень_обработки_1.[КоличествоПриход]
      ,dbo.Свод_ступень_обработки_1.[СуммаПриход]
      ,dbo.Свод_ступень_обработки_1.[ДатаПриемки]
      ,dbo.Свод_ступень_обработки_1.[ВремяПриемки]
      ,dbo.Свод_ступень_обработки_1.[ОстатокНаНачалоШТ]
      ,dbo.Свод_ступень_обработки_1.[ОстатокНаНачалоРознРуб]
      ,dbo.Свод_ступень_обработки_1.[ОборотШТ]
      ,dbo.Свод_ступень_обработки_1.[ОборотРуб]
      ,dbo.Свод_ступень_обработки_1.[ОстатокНаКонецШТ]
      ,dbo.Свод_ступень_обработки_1.[ОстатокНаКонецРознРуб]
      ,dbo.Свод_ступень_обработки_1.[ПродажиШТ]
      ,dbo.Свод_ступень_обработки_1.[ПродажиРуб]
      ,dbo.Свод_ступень_обработки_1.[ПродажиДоПриходаШТ]
      ,dbo.Свод_ступень_обработки_1.[ПродажиДоПриходаРуб]
      ,dbo.Свод_ступень_обработки_1.[ОстатокПередПриходомШТ]
      ,dbo.Свод_ступень_обработки_1.[ОстатокПередПриходомРуб]
      ,dbo.Свод_ступень_обработки_1.[СреднедневныеШТ]
      ,dbo.Свод_ступень_обработки_1.[СреднедневныеРуб]
      ,dbo.Свод_ступень_обработки_1.[СреднедневныеПоДнямНеделиШТ]
      ,dbo.Свод_ступень_обработки_1.[СреднедневныеПоДнямНеделиРуб] 
     , CASE WHEN dbo.Свод_ступень_обработки_1.КодТовара NOT IN
                          (SELECT     Товары.код Код
                            FROM          dbo.Товары AS Товары(nolock) LEFT JOIN
                                                   dbo.Товары AS ПодГруппы(nolock) ON Товары.родитель = подГруппы.код LEFT JOIN
                                                   dbo.Товары AS Группы(nolock) ON подгруппы.родитель = Группы.код
                            WHERE      товары.код IN
                                                       (SELECT     Список.КодГруппы
                                                         FROM          СписокГруппСобственногоПроизводства Список) OR
                                                   подгруппы.код IN
                                                       (SELECT     Список.КодГруппы
                                                         FROM          СписокГруппСобственногоПроизводства Список) OR
                                                   группы.код IN
                                                       (SELECT     Список.КодГруппы
                                                         FROM          СписокГруппСобственногоПроизводства Список)) 
                      THEN CAST(
	                      (CASE WHEN (isnull(dbo.Свод_ступень_обработки_1.ОстатокНаНачалоШТ,0) + isnull([Свод_ступень_обработки_1].ОстатокНаНачалоШТ_ГлДляАвтозаказа, 0) &gt; 0) THEN 0.333334 ELSE 0 END 
	                      + CASE WHEN ((isnull(dbo.Свод_ступень_обработки_1.ОстатокНаКонецШТ,0) + ISNULL([Свод_ступень_обработки_1].ОстатокНаКонецШТ_ГлДляАвтозаказа, 0)) &gt; 0) THEN 0.333334 ELSE 0 END 
	                      + CASE WHEN ((isnull(dbo.Свод_ступень_обработки_1.ОстатокНаНачалоШТ,0) + isnull([Свод_ступень_обработки_1].ОстатокНаНачалоШТ_ГлДляАвтозаказа, 0)
								 - isnull(dbo.Свод_ступень_обработки_1.ПродажиДоПриходаШТ, 0) - isnull([Свод_ступень_обработки_1].ПродажиДоПриходаШТ_ГлДляАвтозаказа, 0)) &gt; 0) THEN 0.333334 ELSE 0 END
                      ) AS decimal(10, 2)) ELSE NULL END AS ДнейНаСкладеПоОстаткам
      ,dbo.Свод_ступень_обработки_1.[ДнейНаСкладеПоПродажам]
      ,dbo.Свод_ступень_обработки_1.[ДнейНаСкладеПоПродажамПоДнямНедели]
      ,dbo.Свод_ступень_обработки_1.[КолВоДней]
      ,dbo.Свод_ступень_обработки_1.[ДнейПродажСП]
      ,dbo.Свод_ступень_обработки_1.[КолВоДнейСП]
      ,dbo.Свод_ступень_обработки_1.[ВидАсс]
      ,dbo.Свод_ступень_обработки_1.[ВидАсс14днейНазад]
      ,dbo.Свод_ступень_обработки_1.[ВидПоставки]
      ,dbo.Свод_ступень_обработки_1.[СтатусНеЗаказывать]
  FROM [dbo].[Свод_ступень_обработки_1]</property>
