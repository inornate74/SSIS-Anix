                    <component
                      refId="Package\КПТ по причинам (сбор данных)\RSC\Загрузка расхождений по заказу СТ из РСЦ (ОТБОР ПО ДАТЕ)\РСЦ"
                      componentClassID="Microsoft.ManagedComponentHost"
                      contactInfo="Extracts data from a relational database by using a .NET provider.;Microsoft Corporation; Microsoft SqlServer v10; © 2007 Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                      description="Extracts data from a relational database by using a .NET provider."
                      name="РСЦ"
                      usesDispositions="true"
                      version="4">
                      <properties>
                        <property
                          dataType="System.String"
                          description="Specifies the SQL statement used by the component to extract data."
                          expressionType="Notify"
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">set datefirst 7
declare @date as datetime
declare @dateN as datetime
declare @curdate as datetime

set @curdate=convert(varchar(16), dateadd(day, -7, getdate()), 112)

set @date =CASE 
WHEN DATEPART(weekday, @curdate) = 1 THEN @curdate 
WHEN DATEPART(weekday, @curdate) = 2 THEN dateadd(day, + 6, @curdate) 
WHEN DATEPART(weekday, @curdate) = 3 THEN dateadd(day, + 5, @curdate) 
WHEN DATEPART(weekday, @curdate) = 4 THEN dateadd(day, + 4, @curdate) 
WHEN DATEPART(weekday, @curdate) = 5 THEN dateadd(day, + 3, @curdate) 
WHEN DATEPART(weekday, @curdate) = 6 THEN dateadd(day, + 2, @curdate) 
WHEN DATEPART(weekday, @curdate) = 7 THEN dateadd(day, + 1, @curdate)
END
set @dateN = dateadd(dd, -21, @date)

select tbl.Дата_плановой_доставки Дата,
tbl.Код_поставщика_RSF ИДПоставщика ,
tbl.Код_товара КодТовара,
hd.Код_магазина КодМагазина,
tbl.Дата_плановой_доставки ДатаЗаказа,
case when 
pd_hd.Дата_ПД is null then Дата_плановой_доставки
else   pd_hd.Дата_ПД end as   ФактическаяДатаДоставки,
Заказ КоличествоЗаказано,
case when  (Проведен=1 or Проведен is null)
 then  isnull(Количество_факт,0)
 else 0 end as КоличествоПриход,
isnull(pd_hd.Цена,0) as Цена,
0 ОтклонениеВЧасах,
'Недопоставка' ВидПретензии,
hd.Дата_заявки_СТ
from dwh.td.t_fact_Заявка_ст_шапки hd
join dwh.td.t_fact_Заявка_ст_строки tbl on tbl.Составной_код_заявки_ст=hd.Составной_код_заявки_СТ
left join dwh.td.v_fact_ПД pd_hd on pd_hd.Составной_код_заявки_ст=tbl.Составной_код_заявки_ст and tbl.Код_товара=pd_hd.Код_товара and Дата_плановой_доставки&gt;=Дата_ПД
join t_dim_Товары tov on tbl.Код_товара=tov.Код_товара
left join DWH.dbo.t_fact_Допустимая_погрешность_количества_товара dp on dp.Код_группы=tov.Код_Группы
where Дата_заявки_СТ between @dateN and @date and tbl.Код_поставщика_RSF not in (24,7120)
and (case when  (Проведен=1 or Проведен is null) then  isnull(Количество_факт,0) else 0 end =0 
or Заказ-Погрешность_количество&gt;isnull(Количество_факт,0))
and (Заказ!=0 or Заказ is null)
and (Заказ!= case when  (Проведен=1 or Проведен is null) then  isnull(Количество_факт,0) else 0 end 
or Количество_факт is null)</property>
