                              description="Команда SQL для выполнения."
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SELECT 
ost.Дата,
    ost.КодМагазина,
    t.Товар_первого_сорта
      AS КодТовара,
   case when SUM(ost.ОстатокНаНачалоШТ)&gt;0 then 1 end  AS ЕстьУценка
FROM
    "dbo"."ОТБРС_Остатки" ost (nolock)
JOIN
    [KPT].[dbo].[v_dim_Товары] t ON ost.КодТовара = t.Код
WHERE
 t.код!= t.Товар_первого_сорта
GROUP BY
    ost.Дата,
    ost.КодМагазина,
    t.Товар_первого_сорта
having SUM(ost.ОстатокНаНачалоШТ)&gt;0</property>
