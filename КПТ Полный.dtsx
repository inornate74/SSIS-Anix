                    <component
                      refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 6 Остатки списания прочие потери\_Свод_временный1"
                      componentClassID="Microsoft.ManagedComponentHost"
                      contactInfo="Extracts data from a relational database by using a .NET provider.;Microsoft Corporation; Microsoft SqlServer v10; © 2007 Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                      description="Extracts data from a relational database by using a .NET provider."
                      name="_Свод_временный1"
                      usesDispositions="true"
                      version="4">
                      <properties>
                        <property
                          dataType="System.String"
                          description="Specifies the SQL statement used by the component to extract data."
                          expressionType="Notify"
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">-- НЕАКТУАЛЬНЫЙ ОСТАТОК
	select
		 C3.Дата Дата
		,C3.КодТовара КодТовара
		,C3.КодПоставщика КодПоставщика
		,C3.[КодМагазина] [КодМагазина]
		,0 КПТаутстоков
		,cast(14 as tinyint) КодПричиныПаденияКПТ
		,left(LTRIM(RTRIM( convert(varchar, C3.Дата, 112)))+'_'+
				RTRIM(LTRIM(CAST(C3.КодТовара as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодМагазина as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодПоставщика as CHAR)))
		,41) ДатаТоварМагазинПоставщик
	from Свод_временный1 C3 with (nolock)
	where 
 		(case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100 
		and C3.КодТовара IN (select top 1 ОТБРС_Остатки.КодТовара from ОТБРС_Остатки with (nolock)
								where ОТБРС_Остатки.КодТовара = C3.КодТовара
									and ОТБРС_Остатки.КодМагазина = C3.КодМагазина
									and ОТБРС_Остатки.Дата = C3.Дата
									and (ОТБРС_Остатки.ОстатокНаНачалоШТ &lt; 0 or ОТБРС_Остатки.ОстатокНаНачалоШТ+ОборотШТ &lt; 0)) 	 
	Union all								
	-- СПИСАНИЕ
	select
		 C3.Дата Дата
		,C3.КодТовара КодТовара
		,C3.КодПоставщика КодПоставщика
		,C3.[КодМагазина] [КодМагазина]
		,0 КПТаутстоков
		,cast(15 as tinyint) КодПричиныПаденияКПТ
		,left(LTRIM(RTRIM( convert(varchar, C3.Дата, 112)))+'_'+
				RTRIM(LTRIM(CAST(C3.КодТовара as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодМагазина as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодПоставщика as CHAR)))
		,41) ДатаТоварМагазинПоставщик
	from Свод_временный1 C3 with (nolock)
	where 
 		(case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100 
		and C3.КодТовара IN (select top 1 Нулевые_Остатки_временный.КодТовара from Нулевые_Остатки_временный with (nolock)
								where Нулевые_Остатки_временный.КодТовара = C3.КодТовара
									and Нулевые_Остатки_временный.КодМагазина = C3.КодМагазина
									and Нулевые_Остатки_временный.Дата &gt;= C3.Дата and (Нулевые_Остатки_временный.[ДатаПоложительногоОстатка] &gt;=(select top 1 Дата_заявки_СТ from dwh.td.t_fact_Заявка_СТ_шапки h
																join dwh.td.t_fact_Заявка_СТ_строки s on s.Составной_код_заявки_СТ=h.Составной_код_заявки_СТ
																where h.Дата_заявки_СТ&gt;=dateadd(d,-14,c3.дата) and
																Дата_заявки_СТ&lt;=C3.Дата and c3.КодТовара=s.Код_товара and c3.КодМагазина=h.Код_магазина
															order by Дата_заявки_СТ desc) or 
                                                                                                                                                                                                                                                       Нулевые_Остатки_временный.[ДатаПоложительногоОстатка] &gt;=(select top 1 [Дата_заявки_РЦ] from dwh.td.t_fact_Заявка_РЦ_шапки h
																join dwh.td.t_fact_Заявка_РЦ_строки s on s.Составной_код_заявки_РЦ=h.Составной_код_заявки_РЦ
																where Дата_заявки_РЦ&gt;= dateadd(d,-14,c3.дата) and
																Дата_заявки_РЦ&lt;=C3.Дата and c3.КодТовара=s.Код_товара and c3.КодМагазина=h.Код_магазина
															order by Дата_заявки_РЦ desc) )
									and Нулевые_Остатки_временный.[ДатаПоложительногоОстатка] &lt; C3.Дата
									and isnull(Нулевые_Остатки_временный.[КолСписаноПослеПоложительногоОстатка],0) &gt; 0) 

	Union all
	 -- ПРОЧИЕ ПОТЕРИ
	select
		 C3.Дата Дата
		,C3.КодТовара КодТовара
		,C3.КодПоставщика КодПоставщика
		,C3.[КодМагазина] [КодМагазина]
		,0 КПТаутстоков
		,cast(10 as tinyint)  КодПричиныПаденияКПТ
		,left(LTRIM(RTRIM( convert(varchar, C3.Дата, 112)))+'_'+
				RTRIM(LTRIM(CAST(C3.КодТовара as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодМагазина as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодПоставщика as CHAR)))
		,41) ДатаТоварМагазинПоставщик
	 from Свод_временный1 C3 with (nolock)
	 where (case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100</property>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.Boolean"
                          description="Indicates whether to allow non-string external columns to be implicitly converted to strings at the output columns."
