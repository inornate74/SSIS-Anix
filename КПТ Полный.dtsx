                <pipeline
                  BLOBTempStoragePath=""
                  bufferTempStoragePath=""
                  version="1">
                  <components>
                    <component
                      refId="Package\КПТ\DWH Продажи\Среднедневные OLAP (ОТБОР ПО ДАТЕ)\DWH"
                      componentClassID="Microsoft.ManagedComponentHost"
                      contactInfo="Extracts data from a relational database by using a .NET provider.;Microsoft Corporation; Microsoft SqlServer v10; © 2007 Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                      description="Extracts data from a relational database by using a .NET provider."
                      name="DWH"
                      usesDispositions="true"
                      version="4">
                      <properties>
                        <property
                          dataType="System.String"
                          description="Specifies the SQL statement used by the component to extract data."
                          expressionType="Notify"
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">/****** Скрипт для команды SelectTopNRows из среды SSMS  ******/
set datefirst 7

declare @date as datetime
declare @dateN as datetime
declare @date5N as datetime
declare @curdate as datetime

set @curdate=convert(varchar(16), dateadd(day, -7, getdate()), 112)

set @date =CASE 
WHEN DATEPART(weekday, @curdate) = 1 THEN @curdate 
WHEN DATEPART(weekday, @curdate) = 2 THEN dateadd(day, + 6, @curdate) 
WHEN DATEPART(weekday, @curdate) = 3 THEN dateadd(day, + 5, @curdate) 
WHEN DATEPART(weekday, @curdate) = 4 THEN dateadd(day, + 4, @curdate) 
WHEN DATEPART(weekday, @curdate) = 5 THEN dateadd(day, + 3, @curdate) 
WHEN DATEPART(weekday, @curdate) = 6 THEN dateadd(day, + 2, @curdate) 
WHEN DATEPART(weekday, @curdate) = 7 THEN dateadd(day, + 1, @curdate)
END
set @dateN = dateadd(dd, -7,@date)
set @date5N = dateadd(dd, -35, @date)

select
	Календарь.val Дата,
	Продажи.КодМагазина,
	case
		when (Продажи.КодТовара &gt; 9999999999) or (Продажи.КодТовара &lt; 0) then 0
		else Продажи.КодТовара
	end as КодТовара,
	Продажи.Количество/28 Количество,
	Продажи.Сумма/28 Сумма
from (SELECT [ИД_дата] val
  FROM [DWH].[dbo].[t_dim_Календарь]
  where ИД_дата between @dateN and @date) Календарь
left join
	(SELECT
	[Код_магазина] as КодМагазина,
	case
		when (Код_товара &gt; 9999999999) or (Код_товара &lt; 0) then 0
		else Код_товара
	end as КодТовара,
	sum([Количество]) as Количество,
    sum([Итоговая_сумма_после_применения_скидок]) as Сумма
		FROM 
			[cass].[v_fact_Детализация_чеков] as ch (nolock)
		left join dbo.t_dim_Магазины as mag on mag.Код=ch.Код_магазина
		where 
			[Дата_добавления_позиции] between @date5N and @dateN
			and Возврат=0
and Код_товара is not null
		and mag.Группа in ('Розница', 'РС Закрытие')
	group by 
		ch.Код_магазина,	
		ch.Код_товара
	) as Продажи
		on 1=1</property>
