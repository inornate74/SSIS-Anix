                        <component
                          refId="Package\КПТ\RSC\Незаказанный товар по причинам\Загрузка незаказанного товара по причинам из RSC (ОТБОР ПО ДАТЕ)\RSC"
                          componentClassID="Microsoft.ManagedComponentHost"
                          contactInfo="Extracts data from a relational database by using a .NET provider.;Microsoft Corporation; Microsoft SqlServer v10; © 2007 Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                          description="Extracts data from a relational database by using a .NET provider."
                          name="RSC"
                          usesDispositions="true"
                          version="4">
                          <properties>
                            <property
                              dataType="System.String"
                              description="Specifies the SQL statement used by the component to extract data."
                              expressionType="Notify"
                              name="SqlCommand"
                              UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">set datefirst 7
declare @date as datetime
declare @dateN as datetime
declare @curdate as datetime

set @curdate=convert(varchar(16), dateadd(day, -7, getdate()), 112)

set @date =CASE 
WHEN DATEPART(weekday, @curdate) = 1 THEN @curdate 
WHEN DATEPART(weekday, @curdate) = 2 THEN dateadd(day, + 6, @curdate) 
WHEN DATEPART(weekday, @curdate) = 3 THEN dateadd(day, + 5, @curdate) 
WHEN DATEPART(weekday, @curdate) = 4 THEN dateadd(day, + 4, @curdate) 
WHEN DATEPART(weekday, @curdate) = 5 THEN dateadd(day, + 3, @curdate) 
WHEN DATEPART(weekday, @curdate) = 6 THEN dateadd(day, + 2, @curdate) 
WHEN DATEPART(weekday, @curdate) = 7 THEN dateadd(day, + 1, @curdate)
END
set @dateN = dateadd(dd, -13, @date)

select
 convert(datetime, convert(varchar, dateadd(yyyy,-2000, РегистрНТ._Period), 112)) Дата,
 спрСтруктурныеЕдиницы._Code КодМагазина,
 спрНоменклатура._Code КодТовара,
 case when cast(спрКонтрагенты._Folder as int) = 0
        then  спрКонтрагенты._Code
        else  (select top 1  спрКонтрагенты2._Code 
                 from _Reference110 спрКонтрагенты2 
                 where спрКонтрагенты2._IDRRef=спрКонтрагенты._ParentIDRRef)  
 end ИДПоставщика,
Case ПеречислениеПричиныНезаказаТовара._EnumOrder 
       When 0 Then 'СтопОтгрузка'
       When 1 Then 'КвантОтгрузки'
       Else 'НеЗадано'
 END ПричинаНаименование,
 РегистрНТ._Fld6590 Количество,
 РегистрНТ._Fld6591 Сумма
from _AccumRg6585 РегистрНТ (nolock)
inner join  _Reference129 спрСтруктурныеЕдиницы (nolock) ON спрСтруктурныеЕдиницы._IDRRef = РегистрНТ._Fld6587RRef
inner join  _Reference114 спрНоменклатура (nolock) ON спрНоменклатура._IDRRef = РегистрНТ._Fld6586RRef
                                                                                             and спрНоменклатура._Code not like '%:%' and спрНоменклатура._Code &lt;&gt;''
inner join _Reference110 спрКонтрагенты (nolock) ON спрКонтрагенты._IDRRef = РегистрНТ._Fld6588RRef
inner join _Enum6582 ПеречислениеПричиныНезаказаТовара  (nolock) ON ПеречислениеПричиныНезаказаТовара._IDRRef =  РегистрНТ._Fld6589RRef 
where  dateadd(yyyy,-2000,   РегистрНТ._Period) between @dateN and @date</property>
