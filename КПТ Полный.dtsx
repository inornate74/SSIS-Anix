            <DTS:Executable
              DTS:refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 4 недопоставки"
              DTS:CreationName="Microsoft.Pipeline"
              DTS:Description="Data Flow Task"
              DTS:DTSID="{60E3231C-59FA-4767-9755-B28044793428}"
              DTS:ExecutableType="Microsoft.Pipeline"
              DTS:LocaleID="-1"
              DTS:ObjectName="Определение причин Этап 2 4 недопоставки"
              DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server v10; (C) 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
              <DTS:Variables />
              <DTS:LoggingOptions
                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <pipeline
                  BLOBTempStoragePath=""
                  bufferTempStoragePath=""
                  version="1">
                  <components>
                    <component
                      refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 4 недопоставки\_Свод_временный1"
                      componentClassID="Microsoft.ManagedComponentHost"
                      contactInfo="Extracts data from a relational database by using a .NET provider.;Microsoft Corporation; Microsoft SqlServer v10; © 2007 Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                      description="Extracts data from a relational database by using a .NET provider."
                      name="_Свод_временный1"
                      usesDispositions="true"
                      version="4">
                      <properties>
                        <property
                          dataType="System.String"
                          description="Specifies the SQL statement used by the component to extract data."
                          expressionType="Notify"
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">-- НЕДОПОСТАВКИ СТ
	select
		 C3.Дата Дата
		,C3.КодТовара КодТовара
		,C3.КодПоставщика КодПоставщика
		,C3.[КодМагазина] [КодМагазина]
		,0 КПТаутстоков
		,cast(5 as tinyint) КодПричиныПаденияКПТ
		,left(LTRIM(RTRIM( convert(varchar, C3.Дата, 112)))+'_'+
				RTRIM(LTRIM(CAST(C3.КодТовара as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодМагазина as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодПоставщика as CHAR)))
		,41) ДатаТоварМагазинПоставщик
	from Свод_временный1 C3 with (nolock)
	where (case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100
		and [КодПоставщика]&lt;&gt;1682
		--проверяем на наличие факта недопоставок в регистре
		and  C3.КодТовара IN (select TOP 1 RSC_ФактРасхождСПоставщиками.КодТовара КодТовара
						from RSC_ФактРасхождСПоставщиками  with (nolock)
						 where RSC_ФактРасхождСПоставщиками.КодТовара = C3.КодТовара
						AND RSC_ФактРасхождСПоставщиками.ДатаЗаказа &lt;= C3.Дата--анализируем только предзаказы
						--AND RSC_ФактРасхождСПоставщиками.Дата &lt;= RSC_ФактРасхождСПоставщиками.ДатаЗаказа
						AND RSC_ФактРасхождСПоставщиками.Дата &lt;= C3.Дата--анализируем только пред. доставку товара
                    and RSC_ФактРасхождСПоставщиками.Дата=(select top 1 Дата_плановой_доставки from dwh.td.t_fact_Заявка_СТ_шапки h
					join dwh.td.t_fact_Заявка_СТ_строки s on s.Составной_код_заявки_СТ=h.Составной_код_заявки_СТ
					where h.Дата_заявки_СТ&gt;=dateadd(d,-21,c3.дата) and
					Дата_плановой_доставки&lt;=C3.Дата and c3.КодТовара=s.Код_товара and c3.КодМагазина=h.Код_магазина
					order by Дата_плановой_доставки desc)
						AND RSC_ФактРасхождСПоставщиками.КодМагазина = C3.КодМагазина
						AND RSC_ФактРасхождСПоставщиками.КоличествоЗаказано &gt; 0
						 order by RSC_ФактРасхождСПоставщиками.ДатаЗаказа desc
						 ) 
		--проверяем приходы после факта недопоставок для следующих дней
		and (case when (select TOP 1 RSC_ФактРасхождСПоставщиками.Дата
						from RSC_ФактРасхождСПоставщиками  with (nolock)
						 where RSC_ФактРасхождСПоставщиками.КодТовара = C3.КодТовара
						AND RSC_ФактРасхождСПоставщиками.ДатаЗаказа &lt;= C3.Дата--анализируем только предзаказы
						AND RSC_ФактРасхождСПоставщиками.Дата &lt;= C3.Дата--анализируем только пред. доставку товара
						AND RSC_ФактРасхождСПоставщиками.КодМагазина = C3.КодМагазина
																					AND RSC_ФактРасхождСПоставщиками.КоличествоЗаказано &gt; 0
						 order by RSC_ФактРасхождСПоставщиками.ДатаЗаказа desc
						 ) is not null 
				then
				isnull((select SUM([RSC_Приход].Количество)
						from [RSC_Приход] with (nolock)
						 where [RSC_Приход].КодТовара = C3.КодТовара
						AND [RSC_Приход].КодМагазина = C3.КодМагазина
						AND [RSC_Приход].Дата &lt; C3.Дата--без равенства, т.к. в этот день недопоставка должна учитываться
						AND cast([RSC_Приход].Дата as DATE) &gt; cast((select TOP 1 RSC_ФактРасхождСПоставщиками.Дата
														from RSC_ФактРасхождСПоставщиками with (nolock)
														 where RSC_ФактРасхождСПоставщиками.КодТовара = C3.КодТовара
														AND RSC_ФактРасхождСПоставщиками.ДатаЗаказа &lt;= C3.Дата--анализируем только предзаказы
														AND RSC_ФактРасхождСПоставщиками.Дата &lt;= C3.Дата--анализируем только пред. доставку товара
														AND RSC_ФактРасхождСПоставщиками.КодМагазина = C3.КодМагазина
														AND RSC_ФактРасхождСПоставщиками.КоличествоЗаказано &gt; 0
														 order by RSC_ФактРасхождСПоставщиками.ДатаЗаказа desc
														 ) as DATE)),0)
				else 0
				end) = 0

			

	Union all
	 -- НЕДОПОСТАВКИ РЦ
	select
		 C3.Дата Дата
		,C3.КодТовара КодТовара
		,C3.КодПоставщика КодПоставщика
		,C3.[КодМагазина] [КодМагазина]
		,0 КПТаутстоков
		,cast(9 as tinyint) КодПричиныПаденияКПТ
		,left(LTRIM(RTRIM( convert(varchar, C3.Дата, 112)))+'_'+
				RTRIM(LTRIM(CAST(C3.КодТовара as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодМагазина as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодПоставщика as CHAR)))
		,41) ДатаТоварМагазинПоставщик
	 from Свод_временный1 C3 with (nolock)
	 left join Товары Тов ON Тов.Код = C3.КодТовара
	 where (case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100
	     and [КодПоставщика]=1682
		 and ((select TOP 1 
				(1 +
					Case When  (RSC_РасхРЦ.[КоличествоПриход] = 0 OR RSC_РасхРЦ.[ФактическаяДатаДоставки]&gt; C3.Дата)
					then 1
																   else
																   (Case When RSC_РасхРЦ.ПогрешностьКоличество&gt;0 
					then 
						(RSC_РасхРЦ.[КоличествоЗаказано]-RSC_РасхРЦ.[КоличествоПриход])-RSC_РасхРЦ.ПогрешностьКоличество
					else 
					   (RSC_РасхРЦ.[КоличествоЗаказано]-RSC_РасхРЦ.[КоличествоПриход])-(RSC_РасхРЦ.[КоличествоПриход]/100 *                                                                     RSC_РасхРЦ.ПогрешностьПроцент)
					end) end
				)
				from RSC_РасхожденияСПрайдом_Свернуто RSC_РасхРЦ with (nolock)
				where RSC_РасхРЦ.КодТовара=C3.КодТовара
						and RSC_РасхРЦ.КодМагазина = C3.КодМагазина
						and RSC_РасхРЦ.[ПлановаяДатаДоставки] &lt;= C3.Дата
																					and RSC_РасхРЦ.[КоличествоЗаказано] &lt;&gt; 0
				order by RSC_РасхРЦ.[ПлановаяДатаДоставки] desc) &gt; 1
									   OR --Проверка на главный для автозаказа
				(select TOP 1 
				(1 +
					Case When  (RSC_РасхРЦ.[КоличествоПриход] = 0 OR RSC_РасхРЦ.[ФактическаяДатаДоставки]&gt; C3.Дата)
					then 1
																   else
																   (Case When RSC_РасхРЦ.ПогрешностьКоличество&gt;0 
					then 
						(RSC_РасхРЦ.[КоличествоЗаказано]-RSC_РасхРЦ.[КоличествоПриход])-RSC_РасхРЦ.ПогрешностьКоличество
					else 
					   (RSC_РасхРЦ.[КоличествоЗаказано]-RSC_РасхРЦ.[КоличествоПриход])-(RSC_РасхРЦ.[КоличествоПриход]/100 *                                                                     RSC_РасхРЦ.ПогрешностьПроцент)
					end) end
				)
				from RSC_РасхожденияСПрайдом_Свернуто RSC_РасхРЦ with (nolock)
				where RSC_РасхРЦ.КодТовара=Тов.КодГлавныйДляАвтозаказа
						and RSC_РасхРЦ.КодМагазина = C3.КодМагазина
						and RSC_РасхРЦ.[ПлановаяДатаДоставки] &lt;= C3.Дата
																					and RSC_РасхРЦ.[КоличествоЗаказано] &lt;&gt; 0
						and Тов.КодГлавныйДляАвтозаказа is not null
				order by RSC_РасхРЦ.[ПлановаяДатаДоставки] desc) &gt; 1)</property>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.Boolean"
                          description="Indicates whether to allow non-string external columns to be implicitly converted to strings at the output columns."
                          name="AllowImplicitStringConversion">true</property>
                        <property
                          dataType="System.String"
                          description="The Destination database table name."
                          expressionType="Notify"
                          name="TableOrViewName"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor"></property>
                        <property
                          dataType="System.Int32"
                          description="Specify the mode to retrieve external column information"
                          name="AccessMode"
                          typeConverter="Microsoft.SqlServer.Dts.Pipeline.DataReaderSourceAdapter+EnumToStringConverter">2</property>
                        <property
                          dataType="System.String"
                          name="UserComponentTypeName">Microsoft.DataReaderSourceAdapter</property>
                      </properties>
                      <connections>
                        <connection
                          refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 4 недопоставки\_Свод_временный1.Connections[IDbConnection]"
                          connectionManagerID="Package.ConnectionManagers[s19-olap.KPT.reader ADO .net]"
                          connectionManagerRefId="Package.ConnectionManagers[s19-olap.KPT.reader ADO .net]"
                          description="Managed connection manager"
                          name="IDbConnection" />
                      </connections>
