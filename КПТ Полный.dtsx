          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{ACF2DB4A-C351-4E89-845A-CFB8050E8574}"
              SQLTask:SqlStatementSource="truncate table ОТБРС_Потери;&#xA;truncate table ОТБРС_Приказы;&#xA;truncate table ОТБРС_ГрафикЗаказаКратко;&#xA;truncate table RSC_ФактРасхождСПоставщиками;&#xA;truncate table RSC_ЗаказыПоставщикам;&#xA;truncate table RSC_РасхожденияСПрайдом;&#xA;truncate table RSC_РегСвед_ДопустимаяПогрешностьКолВаТовара;&#xA;truncate table RSC_РасхожденияСПрайдом_Свернуто;&#xA;truncate table ОТБРС_КорректировкаЗаказа;&#xA;truncate table ОТБРС_Списания;&#xA;truncate table Нулевые_Остатки_временный;&#xA;&#xA;-- Переоценка, Уценка ТСД (ИЗМ 1768)&#xA;truncate table ФактПереоценки;&#xA;truncate table ФактУценкиТСД;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
