            <DTS:Executable
              DTS:refId="Package\КПТ по причинам (сбор данных)\RSC\Загрузка расхождений с Прайд из RSC (ОТБОР ПО ДАТЕ)"
              DTS:CreationName="Microsoft.Pipeline"
              DTS:Description="Data Flow Task"
              DTS:DTSID="{9623762E-A174-4460-AB46-88B9BFA1D864}"
              DTS:ExecutableType="Microsoft.Pipeline"
              DTS:LocaleID="-1"
              DTS:ObjectName="Загрузка расхождений с Прайд из RSC (ОТБОР ПО ДАТЕ)"
              DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server v10; (C) 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
              <DTS:Variables />
              <DTS:ObjectData>
                <pipeline
                  BLOBTempStoragePath=""
                  bufferTempStoragePath=""
                  version="1">
                  <components>
                    <component
                      refId="Package\КПТ по причинам (сбор данных)\RSC\Загрузка расхождений с Прайд из RSC (ОТБОР ПО ДАТЕ)\RSC"
                      componentClassID="Microsoft.ManagedComponentHost"
                      contactInfo="Extracts data from a relational database by using a .NET provider.;Microsoft Corporation; Microsoft SqlServer v10; © 2007 Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                      description="Extracts data from a relational database by using a .NET provider."
                      name="RSC"
                      usesDispositions="true"
                      version="4">
                      <properties>
                        <property
                          dataType="System.String"
                          description="Specifies the SQL statement used by the component to extract data."
                          expressionType="Notify"
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">SET                datefirst 7 DECLARE @date AS datetime DECLARE @dateN AS datetime DECLARE @curdate AS datetime
SET                @curdate = convert(varchar(16), dateadd(day, -7, getdate()), 112)
SET                @date = CASE WHEN DATEPART(weekday, @curdate) = 1 THEN @curdate WHEN DATEPART(weekday, @curdate) = 2 THEN dateadd(day, + 6, @curdate) WHEN DATEPART(weekday, @curdate) = 3 THEN dateadd(day, + 5, 
                         @curdate) WHEN DATEPART(weekday, @curdate) = 4 THEN dateadd(day, + 4, @curdate) WHEN DATEPART(weekday, @curdate) = 5 THEN dateadd(day, + 3, @curdate) WHEN DATEPART(weekday, @curdate) 
                         = 6 THEN dateadd(day, + 2, @curdate) WHEN DATEPART(weekday, @curdate) = 7 THEN dateadd(day, + 1, @curdate) END
SET                @dateN = dateadd(dd, - 21, @date)
                             SELECT        tbl.Дата_плановой_доставки Дата, 0 ВидДвижения, 24 ИДПоставщика, Код_товара КодТовара, Код_магазина КодМагазина, 
                                                       Дата_плановой_доставки ПлановаяДатаДоставки, NULL ФактическаяДатаДоставки, Заказ Количество, Цена, 0 ОтклонениеВЧасах
                              FROM            td.t_fact_Заявка_СТ_шапки hd JOIN
                                                       td.t_fact_Заявка_СТ_строки tbl ON tbl.Составной_код_заявки_СТ = hd.Составной_код_заявки_СТ
                              WHERE        Дата_заявки_СТ BETWEEN @dateN AND @date AND tbl.Код_поставщика_RSF in (24,7120) AND Заказ != 0
UNION ALL
SELECT        tbl.Дата_плановой_доставки Дата, 0 ВидДвижения, 24 ИДПоставщика, Код_товара КодТовара, Код_магазина КодМагазина, Дата_плановой_доставки ПлановаяДатаДоставки, NULL 
                         ФактическаяДатаДоставки, Заказ Количество, Цена, 0 ОтклонениеВЧасах
FROM            td.t_fact_Заявка_РЦ_шапки hd JOIN
                         td.t_fact_Заявка_РЦ_строки tbl ON tbl.Составной_код_заявки_РЦ = hd.Составной_код_заявки_РЦ
WHERE        Дата_заявки_рц BETWEEN @dateN AND @date AND tbl.Код_поставщика_RSF in (24,7120) AND Заказ != 0
UNION ALL
SELECT        tbl.Дата_плановой_доставки Дата, 1 ВидДвижения, 24 ИДПоставщика, pd_hd.Код_товара КодТовара, pd_hd.Код_магазина КодМагазина, 
                         Дата_плановой_доставки ПлановаяДатаДоставки, pd_hd.Дата_ПД ФактическаяДатаДоставки, Количество_факт Количество, pd_hd.Цена, 0 ОтклонениеВЧасах
FROM            td.t_fact_Заявка_рц_шапки hd JOIN
                         td.t_fact_Заявка_рц_строки tbl ON tbl.Составной_код_заявки_рц = hd.Составной_код_заявки_рц LEFT JOIN
                         td.v_fact_ПД pd_hd ON pd_hd.Составной_код_заявки_из_ТЧ = tbl.Составной_код_заявки_рц AND tbl.Код_товара = pd_hd.Код_товара
WHERE        Дата_заявки_рц BETWEEN @dateN AND @date AND tbl.Код_поставщика_RSF in (24,7120) AND (Проведен=1 or Проведен is null) AND Заказ != 0
UNION ALL
SELECT        tbl.Дата_плановой_доставки Дата, 1 ВидДвижения, 24 ИДПоставщика, pd_hd.Код_товара КодТовара, pd_hd.Код_магазина КодМагазина, 
                         Дата_плановой_доставки ПлановаяДатаДоставки, pd_hd.Дата_ПД ФактическаяДатаДоставки, Количество_факт Количество, pd_hd.Цена, 0 ОтклонениеВЧасах
FROM            td.t_fact_Заявка_ст_шапки hd JOIN
                         td.t_fact_Заявка_ст_строки tbl ON tbl.Составной_код_заявки_СТ = hd.Составной_код_заявки_СТ LEFT JOIN
                         td.v_fact_ПД pd_hd ON pd_hd.Составной_код_заявки_из_ТЧ= tbl.Составной_код_заявки_ст AND tbl.Код_товара = pd_hd.Код_товара
WHERE        Дата_заявки_СТ BETWEEN @dateN AND @date AND tbl.Код_поставщика_RSF in (24,7120)  AND (Проведен=1 or Проведен is null) AND Заказ != 0</property>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.Boolean"
                          description="Indicates whether to allow non-string external columns to be implicitly converted to strings at the output columns."
                          name="AllowImplicitStringConversion">true</property>
