                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <pipeline
                  BLOBTempStoragePath=""
                  bufferTempStoragePath=""
                  version="1">
                  <components>
                    <component
                      refId="Package\КПТ\Формирование итоговой таблицы\Свод_ступень_обработки_1\Все источники"
                      componentClassID="Microsoft.ManagedComponentHost"
                      contactInfo="Extracts data from a relational database by using a .NET provider.;Microsoft Corporation; Microsoft SqlServer v10; © 2007 Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                      description="Extracts data from a relational database by using a .NET provider."
                      name="Все источники"
                      usesDispositions="true"
                      version="4">
                      <properties>
                        <property
                          dataType="System.String"
                          description="Specifies the SQL statement used by the component to extract data."
                          expressionType="Notify"
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">--Неделя отчета
                  set datefirst 7
declare @dateBegin as datetime
declare @dateEnd as datetime
declare @curdate as datetime
set @curdate=convert(varchar(16), dateadd(day, -7, getdate()), 112)
set @dateEnd =CASE 
WHEN DATEPART(weekday, @curdate) = 1 THEN @curdate 
WHEN DATEPART(weekday, @curdate) = 2 THEN dateadd(day, + 6, @curdate) 
WHEN DATEPART(weekday, @curdate) = 3 THEN dateadd(day, + 5, @curdate) 
WHEN DATEPART(weekday, @curdate) = 4 THEN dateadd(day, + 4, @curdate) 
WHEN DATEPART(weekday, @curdate) = 5 THEN dateadd(day, + 3, @curdate) 
WHEN DATEPART(weekday, @curdate) = 6 THEN dateadd(day, + 2, @curdate) 
WHEN DATEPART(weekday, @curdate) = 7 THEN dateadd(day, + 1, @curdate)
END
set @dateBegin = dateadd(dd, -6, @dateEnd)

--Запрос
select
	ОТБРС_Матрица.Дата,
	ОТБРС_Матрица.КодТовара,    
	ОТБРС_Матрица.КодПоставщика,
	ОТБРС_Матрица.КодМагазина,
                ОТБРС_Матрица.ВидАсс,
                ОТБРС_Матрица.ВидАсс14денейНазад,
	ОТБРС_Матрица.ТОП,
                ОТБРС_Матрица.ВидПоставки,
                RSC_Приход_Свернуто.КоличествоПриход КоличествоПриход,
	RSC_Приход_Свернуто.СуммаПриход СуммаПриход,
	RSC_Приход_Свернуто.ДатаПриемки,
	RSC_Приход_Свернуто.ВремяПриемки,
	ОТБРС_Остатки.ОстатокНаНачалоШТ,
	ОТБРС_Остатки.ОстатокНаНачалоРознРуб,
	ОТБРС_Остатки.ОборотШТ,
	ОТБРС_Остатки.ОборотРуб,
	ОТБРС_ОстаткиНаКонец.ОстатокНаНачалоШТ + ОТБРС_ОстаткиНаКонец.ОборотШТ ОстатокНаКонецШТ,
	ОТБРС_ОстаткиНаКонец.ОстатокНаНачалоРознРуб + ОТБРС_ОстаткиНаКонец.ОборотРуб ОстатокНаКонецРознРуб,
	OLAP_ПродажиЗаПериод.Количество ПродажиШТ,
	OLAP_ПродажиЗаПериод.Сумма ПродажиРуб,
	OLAP_ПродажиДоПрихода.Количество ПродажиДоПриходаШТ,
	OLAP_ПродажиДоПрихода.Сумма ПродажиДоПриходаРуб,
	case
		when OLAP_ПродажиДоПрихода.Количество is null then ОТБРС_Остатки.ОстатокНаНачалоШТ
		else ОТБРС_Остатки.ОстатокНаНачалоШТ - OLAP_ПродажиДоПрихода.Количество
	end ОстатокПередПриходомШТ,
	case
		when OLAP_ПродажиДоПрихода.Количество is null then ОТБРС_Остатки.ОстатокНаНачалоРознРуб
		else ОТБРС_Остатки.ОстатокНаНачалоРознРуб - OLAP_ПродажиДоПрихода.Сумма
	end ОстатокПередПриходомРуб,
	Среднедневные.Количество СреднедневныеШТ,
	Среднедневные.Сумма СреднедневныеРуб,
	СреднедневныеПоДнямНедели.Количество СреднедневныеПоДнямНеделиШТ,
	СреднедневныеПоДнямНедели.Сумма СреднедневныеПоДнямНеделиРуб,
--vvvvvvvvvvvvvvvv--КПТ по остаткам--vvvvvvvvvvvvvvvv--
case when ОТБРС_Матрица.КодТовара not  in 
(select Товары.код Код
	from
	dbo.Товары as Товары (nolock)
left join
	dbo.Товары as ПодГруппы (nolock)
		on Товары.родитель = подГруппы.код
left join
	dbo.Товары as Группы (nolock)
on подгруппы.родитель = Группы.код		
	where товары.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)) or
	подгруппы.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)) or
	группы.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)))
	
then
cast(case
		when (ОТБРС_Остатки.ОстатокНаНачалоШТ &gt; 0) 
			or ((ОТБРС_ОстаткиНаКонец.ОстатокНаНачалоШТ + ОТБРС_ОстаткиНаКонец.ОборотШТ) &gt; 0) 
			or (case  when OLAP_ПродажиДоПрихода.Количество is null then ОТБРС_Остатки.ОстатокНаНачалоШТ
				else ОТБРС_Остатки.ОстатокНаНачалоШТ - OLAP_ПродажиДоПрихода.Количество
			end) &gt; 0
                                then 
                                (		
		case when (ОТБРС_Остатки.ОстатокНаНачалоШТ &gt; 0) then 0.333334 else 0 end +
		case when ((ОТБРС_ОстаткиНаКонец.ОстатокНаНачалоШТ + ОТБРС_ОстаткиНаКонец.ОборотШТ) &gt; 0) then 0.333334 else 0 end +
		case when ((case  when OLAP_ПродажиДоПрихода.Количество is null then ОТБРС_Остатки.ОстатокНаНачалоШТ	else ОТБРС_Остатки.ОстатокНаНачалоШТ - OLAP_ПродажиДоПрихода.Количество	end) &gt; 0) then 0.333334 else 0 end
		)

		else 0
	end as decimal(10,2)) else NULL end
 ДнейНаСкладеПоОстаткам,
-------------------------------------------------
case when ОТБРС_Матрица.КодТовара not in 
(select Товары.код Код
	from
	dbo.Товары as Товары (nolock)
left join
	dbo.Товары as ПодГруппы (nolock)
		on Товары.родитель = подГруппы.код
left join
	dbo.Товары as Группы (nolock)
on подгруппы.родитель = Группы.код		
	where товары.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)) or
	подгруппы.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)) or
	группы.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)))
	
then	



case
		when (ОТБРС_Остатки.ОстатокНаНачалоШТ &gt; 0)
			and (isnull(OLAP_ПродажиЗаПериод.Количество, 0) &gt;= (0.5 * isnull(Среднедневные.Количество, 0))) then 1
		else 0 end else NULL
		end ДнейНаСкладеПоПродажам,
-----------------------------------------------
case when ОТБРС_Матрица.КодТовара not in 
(select Товары.код Код
	from
	dbo.Товары as Товары (nolock)
left join
	dbo.Товары as ПодГруппы (nolock)
		on Товары.родитель = подГруппы.код
left join
	dbo.Товары as Группы (nolock)
on подгруппы.родитель = Группы.код		
	where товары.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)) or
	подгруппы.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)) or
	группы.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)))
	
then		


case
		when (ОТБРС_Остатки.ОстатокНаНачалоШТ &gt; 0)
			and (isnull(OLAP_ПродажиЗаПериод.Количество, 0) &gt;= (0.5 * isnull(СреднедневныеПоДнямНедели.Количество, 0))) then 1
		else 0 end else NULL
		
	end ДнейНаСкладеПоПродажамПоДнямНедели,
------------------------------------------------	
	case when 
		ОТБРС_Матрица.КодТовара in 
	(select Товары.код Код
	from
	dbo.Товары as Товары (nolock)
left join
	dbo.Товары as ПодГруппы (nolock)
		on Товары.родитель = подГруппы.код
left join
	dbo.Товары as Группы (nolock)
on подгруппы.родитель = Группы.код		
	where товары.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)) or
	подгруппы.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)) or
	группы.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)))
	
then
	case when OLAP_ПродажиЗаПериод.Количество&gt;=isnull((select top 1 ТоварыДляПорога.ПорогПродажДляРасчетаКоэффПродаж from dbo.Товары as ТоварыДляПорога (nolock) where ТоварыДляПорога.Код = спрТовары.Код_Группы_Уровень_1),0)  then 1 else 0
	end else NULL
end ДнейПродажСП,

-------------------------------------------------

case when ОТБРС_Матрица.КодТовара in 
	(select Товары.код Код
	from
	dbo.Товары as Товары (nolock)
left join
	dbo.Товары as ПодГруппы (nolock)
		on Товары.родитель = подГруппы.код
left join
	dbo.Товары as Группы (nolock)
on подгруппы.родитель = Группы.код		
	where товары.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)) or
	подгруппы.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)) or
	группы.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)))

then NULL else 1 end КолВоДней,

-------------------------------------------------

case when ОТБРС_Матрица.КодТовара in 
	(select Товары.код Код
	from
	dbo.Товары as Товары (nolock)
left join
	dbo.Товары as ПодГруппы (nolock)
		on Товары.родитель = подГруппы.код
left join
	dbo.Товары as Группы (nolock)
on подгруппы.родитель = Группы.код		
	where товары.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)) or
	подгруппы.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)) or
	группы.код in (select Список.КодГруппы from СписокГруппСобственногоПроизводства Список (nolock)))

then 1 else NULL end КолВоДнейСП,
	
-------------------------------------------------

case when (select top 1 RSC_СтатусыНеЗаказывать.НеЗаказывать from RSC_СтатусыНеЗаказывать (nolock)
		where RSC_СтатусыНеЗаказывать.КодТовара = ОТБРС_Матрица.КодТовара
		and RSC_СтатусыНеЗаказывать.КодМагазина = ОТБРС_Матрица.КодМагазина
		and RSC_СтатусыНеЗаказывать.Дата &lt; ОТБРС_Матрица.Дата
		and RSC_СтатусыНеЗаказывать.НеЗаказывать &gt; 0
		order by RSC_СтатусыНеЗаказывать.Дата Desc) is null
       then null else 1 end СтатусНеЗаказывать	
	
,isnull(ОТБРС_Остатки_ГлДляАвтозаказа.ОстатокНаНачалоШТ,0) ОстатокНаНачалоШТ_ГлДляАвтозаказа
,isnull(ОТБРС_Остатки_ГлДляАвтозаказа.ОстатокНаНачалоШТ,0) + isnull(ОТБРС_Остатки_ГлДляАвтозаказа.ОборотШТ,0) ОстатокНаКонецШТ_ГлДляАвтозаказа
,isnull(OLAP_ПродажиДоПрихода_ГлДляАвтозаказа.Количество,0) ПродажиДоПриходаШТ_ГлДляАвтозаказа
, спрТовары.Код_Группы_Уровень_1 КодГруппы
from
	ОТБРС_Матрица (nolock)
left join
                (Select 
			RSC_Приход.КодТовара as КодТовара,
			RSC_Приход.КодМагазина as КодМагазина,
			RSC_Приход.ДатаПриемки as ДатаПриемки,
			SUM(RSC_Приход.Количество) as КоличествоПриход,
			SUM(RSC_Приход.Сумма) as СуммаПриход,
			MIN(RSC_Приход.ВремяПриемки) as ВремяПриемки
	 From RSC_Приход (nolock)
	 GROUP BY
	RSC_Приход.КодТовара,
	RSC_Приход.КодМагазина,
	RSC_Приход.ДатаПриемки)	as RSC_Приход_Свернуто
		on RSC_Приход_Свернуто.ДатаПриемки = ОТБРС_Матрица.Дата
		and RSC_Приход_Свернуто.КодТовара = ОТБРС_Матрица.КодТовара
		and RSC_Приход_Свернуто.КодМагазина = ОТБРС_Матрица.КодМагазина

left join
	ОТБРС_Остатки (nolock)
		on ОТБРС_Остатки.Дата = ОТБРС_Матрица.Дата
		and ОТБРС_Остатки.КодТовара = ОТБРС_Матрица.КодТовара
		and ОТБРС_Остатки.КодМагазина = ОТБРС_Матрица.КодМагазина
left join
	ОТБРС_Остатки ОТБРС_ОстаткиНаКонец (nolock)
		on ОТБРС_ОстаткиНаКонец.Дата = ОТБРС_Матрица.Дата
		and ОТБРС_ОстаткиНаКонец.КодТовара = ОТБРС_Матрица.КодТовара
		and ОТБРС_ОстаткиНаКонец.КодМагазина = ОТБРС_Матрица.КодМагазина
left join
	(select
		OLAP_Продажи.ДатаПродажи,
		OLAP_Продажи.КодТовара,
		OLAP_Продажи.КодМагазина,
		sum(OLAP_Продажи.Количество) Количество,
		sum(OLAP_Продажи.Сумма) Сумма
	from OLAP_Продажи (nolock)
	group by
		OLAP_Продажи.ДатаПродажи,
		OLAP_Продажи.КодТовара,
		OLAP_Продажи.КодМагазина
	) OLAP_ПродажиЗаПериод
		on OLAP_ПродажиЗаПериод.ДатаПродажи = ОТБРС_Матрица.Дата
		and OLAP_ПродажиЗаПериод.КодТовара = ОТБРС_Матрица.КодТовара
		and OLAP_ПродажиЗаПериод.КодМагазина = ОТБРС_Матрица.КодМагазина
left join
	(select
		OLAP_Продажи.ДатаПродажи,
		OLAP_Продажи.КодТовара,
		OLAP_Продажи.КодМагазина,
		sum(OLAP_Продажи.Количество) Количество,
		sum(OLAP_Продажи.Сумма) Сумма
	from
		RSC_Приход (nolock)
	left join
		OLAP_Продажи (nolock)
			on OLAP_Продажи.ДатаПродажи = RSC_Приход.ДатаПриемки
			and OLAP_Продажи.ВремяПродажи &lt; RSC_Приход.ВремяПриемки
			and OLAP_Продажи.КодТовара = RSC_Приход.КодТовара
			and OLAP_Продажи.КодМагазина = RSC_Приход.КодМагазина
	group by
		OLAP_Продажи.ДатаПродажи,
		OLAP_Продажи.КодТовара,
		OLAP_Продажи.КодМагазина
	) OLAP_ПродажиДоПрихода
		on OLAP_ПродажиДоПрихода.ДатаПродажи = ОТБРС_Матрица.Дата
		and OLAP_ПродажиДоПрихода.КодТовара = ОТБРС_Матрица.КодТовара
		and OLAP_ПродажиДоПрихода.КодМагазина = ОТБРС_Матрица.КодМагазина
left join
	Среднедневные (nolock)
		on Среднедневные.Дата = ОТБРС_Матрица.Дата
		and Среднедневные.КодМагазина = ОТБРС_Матрица.КодМагазина
		and Среднедневные.КодТовара = ОТБРС_Матрица.КодТовара
left join
	СреднедневныеПоДнямНедели (nolock)
		on СреднедневныеПоДнямНедели.Дата = ОТБРС_Матрица.Дата
		and СреднедневныеПоДнямНедели.КодМагазина = ОТБРС_Матрица.КодМагазина
		and СреднедневныеПоДнямНедели.КодТовара = ОТБРС_Матрица.КодТовара
left join
	Магазины (nolock) on Магазины.Код = ОТБРС_Матрица.КодМагазина

left join
	dbo.Товары as спрТовары  (nolock) ON спрТовары.Код=ОТБРС_Матрица.КодТовара

---- ОСТАТКИ ГЛ для АВТОЗАКАЗА
left join
	dbo.Товары as ТоварГлДляАвтозака (nolock) ON ТоварГлДляАвтозака.Код=ОТБРС_Матрица.КодТовара and ТоварГлДляАвтозака.Код&lt;&gt;ТоварГлДляАвтозака.КодГлавныйДляАвтозаказа
left join
	ОТБРС_Остатки as ОТБРС_Остатки_ГлДляАвтозаказа (nolock)
		on ОТБРС_Остатки_ГлДляАвтозаказа.Дата = ОТБРС_Матрица.Дата
		and ОТБРС_Остатки_ГлДляАвтозаказа.КодТовара = ТоварГлДляАвтозака.КодГлавныйДляАвтозаказа
		and ОТБРС_Остатки_ГлДляАвтозаказа.КодМагазина = ОТБРС_Матрица.КодМагазина
left join
	(select
		OLAP_Продажи.ДатаПродажи,
		OLAP_Продажи.КодТовара,
		OLAP_Продажи.КодМагазина,
		sum(OLAP_Продажи.Количество) Количество,
		sum(OLAP_Продажи.Сумма) Сумма
	from
		RSC_Приход (nolock)
	left join
		OLAP_Продажи (nolock)
			on OLAP_Продажи.ДатаПродажи = RSC_Приход.ДатаПриемки
			and OLAP_Продажи.ВремяПродажи &lt; RSC_Приход.ВремяПриемки
			and OLAP_Продажи.КодТовара = RSC_Приход.КодТовара
			and OLAP_Продажи.КодМагазина = RSC_Приход.КодМагазина
	group by
		OLAP_Продажи.ДатаПродажи,
		OLAP_Продажи.КодТовара,
		OLAP_Продажи.КодМагазина
	) OLAP_ПродажиДоПрихода_ГлДляАвтозаказа
		on OLAP_ПродажиДоПрихода_ГлДляАвтозаказа.ДатаПродажи = ОТБРС_Матрица.Дата
		and OLAP_ПродажиДоПрихода_ГлДляАвтозаказа.КодТовара = ТоварГлДляАвтозака.КодГлавныйДляАвтозаказа
		and OLAP_ПродажиДоПрихода_ГлДляАвтозаказа.КодМагазина = ОТБРС_Матрица.КодМагазина
WHERE
-- отсеиваем следующие магазины:
 Магазины.Код NOT IN (
						SELECT 
								МагазиныНаРеконструкции.[Код]
   
						FROM [Магазины] МагазиныНаРеконструкции (nolock)
						WHERE ОТБРС_Матрица.Дата&lt;МагазиныНаРеконструкции.[ДатаОткрытия] OR (МагазиныНаРеконструкции.[ДатаОткрытия]&lt;'1900-01-01') --Товар в матрице, но магазин еще не открыт
						or (ОТБРС_Матрица.Дата&gt;=МагазиныНаРеконструкции.[ДатаНачалаРеконструкции] and ОТБРС_Матрица.Дата&lt;=МагазиныНаРеконструкции.[ДатаКонцаРеконструкции]) --Товар в матрице, но магазин еще на реконструкции
						
						)</property>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
