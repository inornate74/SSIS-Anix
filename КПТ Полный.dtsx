            <DTS:Executable
              DTS:refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 10 Переоценка, Уценка ТСД"
              DTS:CreationName="Microsoft.Pipeline"
              DTS:Description="Data Flow Task"
              DTS:DTSID="{5A41AF06-AB59-418B-B852-9E806655CCD9}"
              DTS:ExecutableType="Microsoft.Pipeline"
              DTS:LocaleID="-1"
              DTS:ObjectName="Определение причин Этап 2 10 Переоценка, Уценка ТСД"
              DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server v10; (C) 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
              <DTS:Variables />
              <DTS:ObjectData>
                <pipeline
                  BLOBTempStoragePath=""
                  bufferTempStoragePath=""
                  version="1">
                  <components>
                    <component
                      refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 10 Переоценка, Уценка ТСД\Свод временный 1"
                      componentClassID="Microsoft.ManagedComponentHost"
                      contactInfo="Extracts data from a relational database by using a .NET provider.;Microsoft Corporation; Microsoft SqlServer v10; © 2007 Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                      description="Extracts data from a relational database by using a .NET provider."
                      name="Свод временный 1"
                      usesDispositions="true"
                      version="4">
                      <properties>
                        <property
                          dataType="System.String"
                          description="Specifies the SQL statement used by the component to extract data."
                          expressionType="Notify"
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">-- Переоценки
	select
		 C3.Дата Дата
		,C3.КодТовара КодТовара
		,C3.КодПоставщика КодПоставщика
		,C3.[КодМагазина] [КодМагазина]
		,0 КПТаутстоков
		,cast(19 as tinyint) КодПричиныПаденияКПТ
		,left(LTRIM(RTRIM( convert(varchar, C3.Дата, 112)))+'_'+
				RTRIM(LTRIM(CAST(C3.КодТовара as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодМагазина as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодПоставщика as CHAR)))
		,41) ДатаТоварМагазинПоставщик
	from Свод_временный1 C3 with (nolock)
	
	left join ФактПереоценки ФП (nolock) on C3.Дата = ФП.Дата and C3.КодТовара = ФП.КодТовара and C3.КодМагазина = ФП.КодМагазина
	
	where 
 		(case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100 and ФП.Факт = 1
 		
 	union all
 	
 -- Уценки ТСД
	select
		 C3.Дата Дата
		,C3.КодТовара КодТовара
		,C3.КодПоставщика КодПоставщика
		,C3.[КодМагазина] [КодМагазина]
		,0 КПТаутстоков
		,cast(20 as tinyint) КодПричиныПаденияКПТ
		,left(LTRIM(RTRIM( convert(varchar, C3.Дата, 112)))+'_'+
				RTRIM(LTRIM(CAST(C3.КодТовара as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодМагазина as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодПоставщика as CHAR)))
		,41) ДатаТоварМагазинПоставщик
	from Свод_временный1 C3 with (nolock)
	where 
 		(case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100 
		and C3.КодТовара IN (select TOP 1 ТСД .КодТовара from ФактУценкиТСД ТСД with (nolock)
								where  ТСД .КодТовара = C3.КодТовара
								AND ТСД .Дата &lt;= C3.Дата
                                                                                                                                                     and (ТСД.Дата&gt;=(select top 1 Дата_заявки_СТ from dwh.td.t_fact_Заявка_СТ_шапки h
																join dwh.td.t_fact_Заявка_СТ_строки s on s.Составной_код_заявки_СТ=h.Составной_код_заявки_СТ
																where h.Дата_заявки_СТ&gt;=dateadd(d,-14,c3.дата) and
																Дата_заявки_СТ&lt;=C3.Дата and c3.КодТовара=s.Код_товара and c3.КодМагазина=h.Код_магазина
															order by Дата_заявки_СТ desc) or 
                                                                                                                                                                                                                                                       ТСД.Дата&gt;=(select top 1 [Дата_заявки_РЦ] from dwh.td.t_fact_Заявка_РЦ_шапки h
																join dwh.td.t_fact_Заявка_РЦ_строки s on s.Составной_код_заявки_РЦ=h.Составной_код_заявки_РЦ
																where Дата_заявки_РЦ&gt;= dateadd(d,-14,c3.дата) and
																Дата_заявки_РЦ&lt;=C3.Дата and c3.КодТовара=s.Код_товара and c3.КодМагазина=h.Код_магазина
															order by Дата_заявки_РЦ desc) )


								AND ТСД .КодМагазина = C3.КодМагазина
								)
 	union all---остатки на уценке---
	select
		 C3.Дата Дата
		,C3.КодТовара КодТовара
		,C3.КодПоставщика КодПоставщика
		,C3.[КодМагазина] [КодМагазина]
		,0 КПТаутстоков
		,cast(22 as tinyint) КодПричиныПаденияКПТ
		,left(LTRIM(RTRIM( convert(varchar, C3.Дата, 112)))+'_'+
				RTRIM(LTRIM(CAST(C3.КодТовара as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодМагазина as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодПоставщика as CHAR)))
		,41) ДатаТоварМагазинПоставщик
	from Свод_временный1 C3 with (nolock)
	where 
 		(case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100 
		and C3.КодТовара IN (select TOP 1 УЦ .КодТовара from [ОТБРС_Остатки_уценка] УЦ with (nolock)
								where  УЦ .КодТовара = C3.КодТовара

								AND УЦ.Дата &lt;= C3.Дата and (УЦ.Дата&gt;= (select top 1 Дата_заявки_СТ from dwh.td.t_fact_Заявка_СТ_шапки h
																join dwh.td.t_fact_Заявка_СТ_строки s on s.Составной_код_заявки_СТ=h.Составной_код_заявки_СТ
																where h.Дата_заявки_СТ&gt;=dateadd(d,-14,c3.дата) and
																Дата_заявки_СТ&lt;=C3.Дата and c3.КодТовара=s.Код_товара and c3.КодМагазина=h.Код_магазина
															order by Дата_заявки_СТ desc) or 
                                                                УЦ .Дата&gt;=(select top 1 [Дата_заявки_РЦ] from dwh.td.t_fact_Заявка_РЦ_шапки h
																join dwh.td.t_fact_Заявка_РЦ_строки s on s.Составной_код_заявки_РЦ=h.Составной_код_заявки_РЦ
																where Дата_заявки_РЦ&gt;= dateadd(d,-14,c3.дата) and
																Дата_заявки_РЦ&lt;=C3.Дата and c3.КодТовара=s.Код_товара and c3.КодМагазина=h.Код_магазина
															order by Дата_заявки_РЦ desc) )
								AND УЦ.КодМагазина = C3.КодМагазина
								)</property>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">9999</property>
                        <property
                          dataType="System.Boolean"
                          description="Indicates whether to allow non-string external columns to be implicitly converted to strings at the output columns."
                          name="AllowImplicitStringConversion">true</property>
                        <property
                          dataType="System.String"
                          description="The Destination database table name."
                          expressionType="Notify"
                          name="TableOrViewName"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor"></property>
                        <property
                          dataType="System.Int32"
                          description="Specify the mode to retrieve external column information"
                          name="AccessMode"
                          typeConverter="Microsoft.SqlServer.Dts.Pipeline.DataReaderSourceAdapter+EnumToStringConverter">2</property>
                        <property
                          dataType="System.String"
                          name="UserComponentTypeName">Microsoft.DataReaderSourceAdapter</property>
                      </properties>
                      <connections>
                        <connection
                          refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 10 Переоценка, Уценка ТСД\Свод временный 1.Connections[IDbConnection]"
                          connectionManagerID="Package.ConnectionManagers[s19-olap.KPT.reader ADO .net]"
                          connectionManagerRefId="Package.ConnectionManagers[s19-olap.KPT.reader ADO .net]"
                          description="Managed connection manager"
                          name="IDbConnection" />
                      </connections>
                      <outputs>
                        <output
                          refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 10 Переоценка, Уценка ТСД\Свод временный 1.Outputs[ADO NET Source Output]"
                          name="ADO NET Source Output">
                          <outputColumns>
                            <outputColumn
                              refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 10 Переоценка, Уценка ТСД\Свод временный 1.Outputs[ADO NET Source Output].Columns[Дата]"
                              dataType="dbDate"
                              errorOrTruncationOperation="Преобразование"
                              errorRowDisposition="FailComponent"
                              externalMetadataColumnId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 10 Переоценка, Уценка ТСД\Свод временный 1.Outputs[ADO NET Source Output].ExternalColumns[Дата]"
                              lineageId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 10 Переоценка, Уценка ТСД\Свод временный 1.Outputs[ADO NET Source Output].Columns[Дата]"
                              name="Дата"
                              truncationRowDisposition="FailComponent" />
                            <outputColumn
                              refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 10 Переоценка, Уценка ТСД\Свод временный 1.Outputs[ADO NET Source Output].Columns[КодТовара]"
                              dataType="i8"
                              errorOrTruncationOperation="Преобразование"
