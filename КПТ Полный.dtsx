            <DTS:Executable
              DTS:refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 5 Причины заказа"
              DTS:CreationName="Microsoft.Pipeline"
              DTS:Description="Data Flow Task"
              DTS:DTSID="{485AC2B9-9CC2-4C90-8976-1A538207388F}"
              DTS:ExecutableType="Microsoft.Pipeline"
              DTS:LocaleID="-1"
              DTS:ObjectName="Определение причин Этап 2 5 Причины заказа"
              DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server v10; (C) 2007 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
              <DTS:Variables />
              <DTS:LoggingOptions
                DTS:FilterKind="0" />
              <DTS:ObjectData>
                <pipeline
                  BLOBTempStoragePath=""
                  bufferTempStoragePath=""
                  version="1">
                  <components>
                    <component
                      refId="Package\КПТ по причинам (определение причин)\Определение причин\Определение причин Этап 2 5 Причины заказа\_Свод_временный1"
                      componentClassID="Microsoft.ManagedComponentHost"
                      contactInfo="Extracts data from a relational database by using a .NET provider.;Microsoft Corporation; Microsoft SqlServer v10; © 2007 Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;4"
                      description="Extracts data from a relational database by using a .NET provider."
                      name="_Свод_временный1"
                      usesDispositions="true"
                      version="4">
                      <properties>
                        <property
                          dataType="System.String"
                          description="Specifies the SQL statement used by the component to extract data."
                          expressionType="Notify"
                          name="SqlCommand"
                          UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">-- КОРРЕКТИРОВКА ЗАКАЗА
	select
		 C3.Дата Дата
		,C3.КодТовара КодТовара
		,C3.КодПоставщика КодПоставщика
		,C3.[КодМагазина] [КодМагазина]
		,0 КПТаутстоков
		,cast(11 as tinyint) КодПричиныПаденияКПТ
		,left(LTRIM(RTRIM( convert(varchar, C3.Дата, 112)))+'_'+
				RTRIM(LTRIM(CAST(C3.КодТовара as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодМагазина as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодПоставщика as CHAR)))
		,41) ДатаТоварМагазинПоставщик
	from Свод_временный1 C3 with (nolock)
	where 
 		(case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100 
		and C3.КодТовара	IN (select TOP 1 ОТБРС_КорректировкаЗаказа.КодТовара from ОТБРС_КорректировкаЗаказа with (nolock)
					where  ОТБРС_КорректировкаЗаказа.КодТовара = C3.КодТовара
					AND ОТБРС_КорректировкаЗаказа.КодМагазина = C3.КодМагазина
					AND ОТБРС_КорректировкаЗаказа.Дата&lt;C3.Дата
																	order by ОТБРС_КорректировкаЗаказа.Дата desc)

	Union all
	-- ПРОВЕРИТЬ ЗАКАЗ
	select
		 C3.Дата Дата
		,C3.КодТовара КодТовара
		,C3.КодПоставщика КодПоставщика
		,C3.[КодМагазина] [КодМагазина]
		,0 КПТаутстоков
		,cast(12 as tinyint) КодПричиныПаденияКПТ
		,left(LTRIM(RTRIM( convert(varchar, C3.Дата, 112)))+'_'+
				RTRIM(LTRIM(CAST(C3.КодТовара as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодМагазина as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодПоставщика as CHAR)))
		,41) ДатаТоварМагазинПоставщик
	from Свод_временный1 C3 with (nolock)
	where 
 		(case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100 
		and (Case when (select TOP 1 RSC_Приход.[Количество] from RSC_Приход with (nolock)
								where  RSC_Приход.КодТовара = C3.КодТовара
								AND RSC_Приход.КодМагазина = C3.КодМагазина
								AND convert(varchar(8),RSC_Приход.Дата,112)&lt;C3.Дата
								order by RSC_Приход.Дата desc) is null
				then 1
				else
				 (select TOP 1 RSC_Приход.[Количество]+Остатки.ОстатокНаНачалоШТ from RSC_Приход with (nolock)
								left join ОТБРС_Остатки Остатки (nolock) ON Остатки.Дата = convert(varchar(8),RSC_Приход.Дата ,112)
										and Остатки.КодТовара = RSC_Приход.КодТовара
										and Остатки.КодМагазина = RSC_Приход.КодМагазина
								where  RSC_Приход.КодТовара = C3.КодТовара
								AND RSC_Приход.КодМагазина = C3.КодМагазина
								AND convert(varchar(8),RSC_Приход.Дата,112)&lt;C3.Дата
								order by RSC_Приход.Дата desc)
					- (select SUM(OLAP_Продажи.Количество) from OLAP_Продажи with (nolock) WHERE OLAP_Продажи.КодТовара=C3.КодТовара
											and OLAP_Продажи.КодМагазина=C3.КодМагазина
											and (OLAP_Продажи.ДатаПродажи 
												between (select TOP 1 convert(varchar(8),RSC_Приход.Дата,112) from RSC_Приход with (nolock)
																			where  RSC_Приход.КодТовара = C3.КодТовара
																			AND RSC_Приход.КодМагазина = C3.КодМагазина
																			AND convert(varchar(8),RSC_Приход.Дата,112)&lt;C3.Дата
																			order by RSC_Приход.Дата desc) 
															and C3.Дата))
				
				end) &lt;= 0 

	-- СТАТУСЫ "НЕ ЗАКАЗЫВАТЬ" В ЗАЯВКАХ
	Union all
	select
		 C3.Дата Дата
		,C3.КодТовара КодТовара
		,C3.КодПоставщика КодПоставщика
		,C3.[КодМагазина] [КодМагазина]
		,0 КПТаутстоков
		,cast(13 as tinyint) КодПричиныПаденияКПТ
		,left(LTRIM(RTRIM( convert(varchar, C3.Дата, 112)))+'_'+
				RTRIM(LTRIM(CAST(C3.КодТовара as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодМагазина as CHAR)))+'_'+
		LTRIM(RTRIM( CAST(C3.КодПоставщика as CHAR)))
		,41) ДатаТоварМагазинПоставщик
	from Свод_временный1 C3 with (nolock)
	where 
 		(case when C3.КолВоДней = null then 0 else Round(C3.ДнейНаСкладеПоОстаткам/C3.КолВоДней*100, 2) end) &lt; 100 
		and C3.КодТовара IN (select top 1 RSC_СтатусыНеЗаказывать.КодТовара from RSC_СтатусыНеЗаказывать with (nolock)
								where RSC_СтатусыНеЗаказывать.КодТовара = C3.КодТовара
									and RSC_СтатусыНеЗаказывать.КодМагазина = C3.КодМагазина
									and RSC_СтатусыНеЗаказывать.Дата &lt; C3.Дата
									and RSC_СтатусыНеЗаказывать.НеЗаказывать &gt; 0
									order by RSC_СтатусыНеЗаказывать.Дата Desc)</property>
                        <property
                          dataType="System.Int32"
                          description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                          name="CommandTimeout">0</property>
                        <property
                          dataType="System.Boolean"
                          description="Indicates whether to allow non-string external columns to be implicitly converted to strings at the output columns."
